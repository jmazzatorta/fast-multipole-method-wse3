// kernels.csl - FMM mathematical kernels (2.5D), PACKED SIGNS
//
// Reused UNCHANGED from the 3D implementation: the translation operators
// (M2M/M2L/L2L), the solid-harmonics recurrences, and the packed-sign decode
// are all geometry-independent. They depend only on the relative translation
// vector between two cells and on the expansion order P, never on how cells are
// mapped onto the PE mesh. An M2L between two cubes separated by (+2,-1,0) uses
// the same matrix in 3D and in 2.5D. Only the communication layer changes.
//
// Packed signs: the four sign arrays (sign_rr/ri/ir/ii) are packed into a
// single value, 4 bits per entry:
//   bit 0 = sign_rr (1 = negative, 0 = positive)
//   bit 1 = sign_ri
//   bit 2 = sign_ir
//   bit 3 = sign_ii
//
// Runtime decode uses @bitcast from u32 to f32 to avoid branches:
//   float +1.0 = 0x3F800000
//   float -1.0 = 0xBF800000
// The two differ only in bit 31, so for a "negative" flag in {0,1}:
//   float = bitcast<f32>(0x3F800000 | (negative << 31))
//
// NOTE on the entry counts: they are DERIVED from the table generator, not
// hand-coded. M2L has no table: translate_m2l.

param P: u16;
param M2M_N_ENTRIES: u16;
param L2L_N_ENTRIES: u16;
param N_BUCKETS: u16;

const N_COEFFS: u16 = (P + 1) * (P + 2) / 2;
const C_BUF_SIZE: u16 = N_COEFFS * 2;


const math = @import_module("<math>");

const FLOAT_PLUS_ONE_BITS:  u32 = 0x3F800000;
const FLOAT_MINUS_ONE_BITS: u32 = 0xBF800000;

// Decode a single sign from the packed value.
// signs: holds 4 signs in bits 0..3.
// bit_idx: 0..3 (0 = rr, 1 = ri, 2 = ir, 3 = ii).
// Returns +1.0 if the bit is 0, -1.0 if the bit is 1.
fn decode_sign(signs: u16, bit_idx: u16) f32 {
    const negative: u32 = @as(u32, (signs >> bit_idx) & 1);
    const sign_bits: u32 = FLOAT_PLUS_ONE_BITS | (negative << 31);
    return @bitcast(f32, sign_bits);
}


// --- Solid Harmonics Computation ---
//
// Cartesian recurrence for solid harmonics up to order P. No trigonometric
// calls: the WSE-3 has no trig unit. Real/imaginary parts are interleaved in
// the output buffer (index 2k = real, 2k+1 = imag), ordered by (l,m) as given
// by get_mem_idx in the generator. This ordering is the shared contract between
// the operator tables and every buffer the kernels read or write.

fn compute_solid_harmonics(dx: f32, dy: f32, dz: f32, buf: *[C_BUF_SIZE]f32) void {

    for (@range(u16, C_BUF_SIZE)) |i| {
        buf.*[i] = 0.0;
    }

    var r2: f32 = dx * dx + dy * dy + dz * dz;

    var mm_r: f32 = 1.0;
    var mm_c: f32 = 0.0;

    var i_m: u16 = 0;

    for (@range(i16, P + 1)) |m| {

        if (m > 0) {
            var k_diag: f32 = -1.0 / (2.0 * @as(f32, m));
            var temp_r: f32 = k_diag * (dx * mm_r - dy * mm_c);
            var temp_c: f32 = k_diag * (dy * mm_r + dx * mm_c);
            mm_r = temp_r;
            mm_c = temp_c;
        }

        buf.*[i_m] = mm_r;
        buf.*[i_m + 1] = mm_c;
        i_m += 2;

        var prev2_r: f32 = 0.0;
        var prev2_c: f32 = 0.0;
        var prev1_r: f32 = mm_r;
        var prev1_c: f32 = mm_c;

        for (@range(i16, m + 1, P + 1, 1)) |l| {

            var k_lm: f32 = 1.0 / @as(f32, l * l - m * m);
            var z_k: f32 = (2.0 * @as(f32, l) - 1.0) * dz;

            var current_r: f32 = k_lm * (z_k * prev1_r - r2 * prev2_r);
            var current_c: f32 = k_lm * (z_k * prev1_c - r2 * prev2_c);

            buf.*[i_m] = current_r;
            buf.*[i_m + 1] = current_c;
            i_m += 2;

            prev2_r = prev1_r;
            prev2_c = prev1_c;
            prev1_r = current_r;
            prev1_c = current_c;
        }
    }
}


// --- M2M Translation (PACKED SIGNS) ---
//
// Pure function: translates a child multipole into its parent using the
// precomputed sparse table (offsets / child_indices / v_indices / signs). It
// knows nothing about where the data physically lives. In 2.5D the caller has
// already brought the source expansion into local SRAM (via a plane exchange);
// the accumulation here is identical to 3D.

// --- Sparse translation (M2M / L2L; M2L: translate_m2l) ---
//
// One expansion through a precomputed CSR operator table (offsets + source/v
// indices + packed signs). Pointers are unsized [*]T: the loop is CSR-bounded by
// `offsets`, so the compile-time array length is never used in the body.
//   src_buf = the source expansion (child for M2M, parent for L2L); tgt_buf = the
//   target it accumulates (+=) into; v_buf = translation-vector harmonics.
fn translate(
    v_buf: [*]f32,
    src_buf: [*]f32,
    tgt_buf: [*]f32,
    offsets: [*]u16,
    src_indices: [*]u16,
    v_indices: [*]u16,
    signs: [*]u32
) void {
    for (@range(u16, N_COEFFS)) |f_idx| {
        var accum_r: f32 = 0.0;
        var accum_i: f32 = 0.0;
        const start_idx: u16 = offsets[f_idx];
        const end_idx: u16 = offsets[f_idx + 1];
        for (@range(u16, start_idx, end_idx, 1)) |i| {
            const ci: u16 = src_indices[i];
            const c_r: f32 = src_buf[ci];
            const c_i: f32 = src_buf[ci + 1];
            const vi: u16 = v_indices[i];
            const v_r: f32 = v_buf[vi];
            const v_i: f32 = v_buf[vi + 1];
            const s: u16 = @as(u16, signs[i] & 0xFFFF);
            const s_rr: f32 = decode_sign(s, 0);
            const s_ri: f32 = decode_sign(s, 1);
            const s_ir: f32 = decode_sign(s, 2);
            const s_ii: f32 = decode_sign(s, 3);
            accum_r += s_rr * c_r * v_r + s_ri * c_i * v_i;
            accum_i += s_ir * c_r * v_i + s_ii * c_i * v_r;
        }
        const p_idx: u16 = f_idx * 2;
        tgt_buf[p_idx] += accum_r;
        tgt_buf[p_idx + 1] += accum_i;
    }
}


// --- M2L without a table, rectangular ---
//
// L_j^p = (-1)^n sum_{n,k} M_n^k W_{n+j}^{p+k},  W^{-m} = (-1)^m conj(W^m),
// with W the irregular harmonics of (-x, y, -z), v = (x, y, z) = c_t - c_s, which absorbs
// (-1)^j and the conjugate of the table form. On flat arrays of row width R = 2P + 1, W at
// (m + P) R + l and L at p R + j, for fixed (n, k) over q = p R + j:
//   L[q] += (-1)^n M_n^k W[q + (k + P) R + n]
// one contiguous @fmacs per real product. Slots j > P and j < p are written, never read; W
// slots with l < |m| stay zero. Same result as the term-by-term sum up to f32 rounding
// (testbench/kernels/kt2_*, worst element 4.7e-7 at P4).
const M2L_R : u16 = 2 * P + 1;
const M2L_R_I : i16 = @as(i16, M2L_R);
const M2L_W_LEN : u16 = (3 * P + 1) * M2L_R;
const M2L_L_LEN : u16 = P * M2L_R + P + 1;
var m2l_wr = @zeros([M2L_W_LEN]f32);
var m2l_wi = @zeros([M2L_W_LEN]f32);
var m2l_lr = @zeros([M2L_L_LEN]f32);
var m2l_li = @zeros([M2L_L_LEN]f32);
var m2l_row = @zeros([P + 1]u16);       // float index of (m, m) in a target of order P
var m2l_a1 = @zeros([1]f32);
var m2l_a2 = @zeros([2]f32);
const m2l_a1_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |ix|{1} -> m2l_a1[ix] });
const m2l_a2_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |ix|{1} -> m2l_a2[2 * ix] });
const m2l_lr_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |ix|{M2L_L_LEN} -> m2l_lr[ix] });
const m2l_li_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |ix|{M2L_L_LEN} -> m2l_li[ix] });
const m2l_wr_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |ix|{M2L_L_LEN} -> m2l_wr[ix] });
const m2l_wi_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |ix|{M2L_L_LEN} -> m2l_wi[ix] });

// Call once before the first translate_m2l.
fn m2l_init() void {
    var a : u16 = 0;
    for (@range(u16, P + 1)) |m| {
        m2l_row[m] = a;
        a += 2 * (P + 1 - m);
    }
}

// Rows m >= 0 of W. Same recurrence as fmm_ref.compute_irregular_harmonics_2p.
fn m2l_harmonics(dx: f32, dy: f32, dz: f32) void {
    const r2 : f32 = dx * dx + dy * dy + dz * dz;
    const inv_r2 : f32 = 1.0 / r2;
    var mm_r : f32 = 1.0 / math.sqrt(r2);
    var mm_c : f32 = 0.0;
    const P2 : i16 = 2 * @as(i16, P);
    var row : u16 = P * M2L_R;
    for (@range(i16, P2 + 1)) |m| {
        if (m > 0) {
            const k_diag : f32 = @as(f32, -(2 * m - 1)) * inv_r2;
            const temp_r : f32 = k_diag * (dx * mm_r - dy * mm_c);
            const temp_c : f32 = k_diag * (dy * mm_r + dx * mm_c);
            mm_r = temp_r;
            mm_c = temp_c;
        }
        var at : u16 = row + @as(u16, m);
        m2l_wr[at] = mm_r;
        m2l_wi[at] = mm_c;
        at += 1;
        var prev2_r : f32 = 0.0;
        var prev2_c : f32 = 0.0;
        var prev1_r : f32 = mm_r;
        var prev1_c : f32 = mm_c;
        for (@range(i16, m + 1, P2 + 1, 1)) |l| {
            const a : f32 = @as(f32, 2 * l - 1) * dz;
            const b : f32 = @as(f32, (l - 1) * (l - 1) - m * m);
            const cur_r : f32 = (a * prev1_r - b * prev2_r) * inv_r2;
            const cur_c : f32 = (a * prev1_c - b * prev2_c) * inv_r2;
            m2l_wr[at] = cur_r;
            m2l_wi[at] = cur_c;
            at += 1;
            prev2_r = prev1_r;
            prev2_c = prev1_c;
            prev1_r = cur_r;
            prev1_c = cur_c;
        }
        row += M2L_R;
    }
}

// Rows m < 0 from rows m > 0.
fn m2l_negative_rows() void {
    for (@range(u16, 1, P + 1, 1)) |m| {
        const len : u16 = 2 * P + 1 - m;
        const from : u16 = (m + P) * M2L_R + m;
        const to : u16 = (P - m) * M2L_R + m;
        var fr = @set_dsd_base_addr(m2l_a1_dsd, @ptrcast([*]f32, &m2l_wr[from]));
        fr = @set_dsd_length(fr, len);
        var fi = @set_dsd_base_addr(m2l_a1_dsd, @ptrcast([*]f32, &m2l_wi[from]));
        fi = @set_dsd_length(fi, len);
        var tr = @set_dsd_base_addr(m2l_a1_dsd, @ptrcast([*]f32, &m2l_wr[to]));
        tr = @set_dsd_length(tr, len);
        var ti = @set_dsd_base_addr(m2l_a1_dsd, @ptrcast([*]f32, &m2l_wi[to]));
        ti = @set_dsd_length(ti, len);
        if ((m & 1) == 1) {
            @fnegs(tr, fr);
            @fmovs(ti, fi);
        } else {
            @fmovs(tr, fr);
            @fnegs(ti, fi);
        }
    }
}

// Accumulates (+=) into tgt. (dx, dy, dz) = (-x, y, -z) of v; src: the source expansion.
fn translate_m2l(dx: f32, dy: f32, dz: f32, src: [*]f32, tgt: [*]f32) void {
    m2l_harmonics(dx, dy, dz);
    m2l_negative_rows();
    @fmovs(m2l_lr_dsd, 0.0);
    @fmovs(m2l_li_dsd, 0.0);
    for (@range(u16, P + 1)) |n| {
        const s0 : f32 = if ((n & 1) == 1) -1.0 else 1.0;
        const ni : i16 = @as(i16, n);
        var off : i16 = @as(i16, (P - n) * M2L_R + n);
        var k : i16 = -ni;
        while (k <= ni) {
            const ak : u16 = @as(u16, if (k < 0) -k else k);
            const a_i : u16 = m2l_row[ak] + 2 * (n - ak);
            var s : f32 = s0;
            if (k < 0 and (ak & 1) == 1) {
                s = -s;
            }
            const a : f32 = s * src[a_i];
            var b : f32 = s * src[a_i + 1];
            if (k < 0) {
                b = -b;
            }
            const wr = @increment_dsd_offset(m2l_wr_dsd, off, f32);
            const wi = @increment_dsd_offset(m2l_wi_dsd, off, f32);
            @fmacs(m2l_lr_dsd, m2l_lr_dsd, wr, a);
            @fmacs(m2l_li_dsd, m2l_li_dsd, wi, a);
            if (k != 0) {
                @fmacs(m2l_lr_dsd, m2l_lr_dsd, wi, -b);
                @fmacs(m2l_li_dsd, m2l_li_dsd, wr, b);
            }
            off += M2L_R_I;
            k += 1;
        }
    }
    // Into the interleaved triangular target; Im L^0 is zero by structure.
    for (@range(u16, P + 1)) |p| {
        const base : u16 = m2l_row[p];
        const at : u16 = p * M2L_R + p;
        const len : u16 = P + 1 - p;
        var tr = @set_dsd_base_addr(m2l_a2_dsd, @ptrcast([*]f32, &tgt[base]));
        tr = @set_dsd_length(tr, len);
        var lr = @set_dsd_base_addr(m2l_a1_dsd, @ptrcast([*]f32, &m2l_lr[at]));
        lr = @set_dsd_length(lr, len);
        @fadds(tr, tr, lr);
        if (p != 0) {
            var ti = @set_dsd_base_addr(m2l_a2_dsd, @ptrcast([*]f32, &tgt[base + 1]));
            ti = @set_dsd_length(ti, len);
            var li = @set_dsd_base_addr(m2l_a1_dsd, @ptrcast([*]f32, &m2l_li[at]));
            li = @set_dsd_length(li, len);
            @fadds(ti, ti, li);
        }
    }
}


// --- Memory index for (l,m) in a C_BUF_SIZE buffer (matches get_mem_idx) ---
// Returns the FLOAT index of the real part of R_l^m (imag is +1). For m<0 or
// |m|>l or l<0 the caller must handle out-of-range (returns 0, caller guards).
fn lm_index(l: i16, m: i16) u16 {
    var pos: u16 = 0;
    var mm: i16 = 0;
    const Pi: i16 = @as(i16, P);
    while (mm < m) {
        // All operands in i16 to avoid a u16/i16 mix; result is always >= 1.
        pos += @as(u16, Pi + 1 - mm);
        mm += 1;
    }
    pos += @as(u16, l - m);
    return pos * 2;
}

// Signed access to R_l^m with the conjugate relation for m<0:
//   R_l^{-m} = (-1)^m conj(R_l^m)
// Writes (re,im) into out_r/out_i; zero if l<0 or |m|>l.
fn R_signed(r_buf: *[C_BUF_SIZE]f32, l: i16, m: i16, out_r: *f32, out_i: *f32) void {
    var am: i16 = if (m < 0) -m else m;
    if (l < 0 or am > l) {
        out_r.* = 0.0; out_i.* = 0.0;
        return;
    }
    const base: u16 = lm_index(l, am);
    const rr: f32 = r_buf.*[base];
    const ri: f32 = r_buf.*[base + 1];
    if (m >= 0) {
        out_r.* = rr; out_i.* = ri;
    } else {
        // (-1)^m conj : for m<0, factor (-1)^{am}, conjugate flips imag sign
        const sgn: f32 = if (am % 2 == 0) 1.0 else -1.0;
        out_r.* = sgn * rr;
        out_i.* = -sgn * ri;
    }
}


// --- L2P Evaluation (potential AND forces) ---
//
// Potential:  phi = sum_lm w (L_r R_r - L_i R_i), w = 1 (m=0) else 2.
// Force = +grad(phi) (the same convention as P2P and the direct N-body
// reference: f = sum q (x_s - x_t) / r^3), using the verified gradient relations (this normalization,
// confirmed numerically to ~1e-11):
//   dR_l^m/dx = -0.5 R_{l-1}^{m-1} + 0.5 R_{l-1}^{m+1}
//   dR_l^m/dy = -0.5i R_{l-1}^{m-1} - 0.5i R_{l-1}^{m+1}
//   dR_l^m/dz =        R_{l-1}^m
// with R_l^{-m} = (-1)^m conj(R_l^m).
fn evaluate_l2p(
    dx: f32, dy: f32, dz: f32,
    l_coeffs: *[C_BUF_SIZE]f32,
    pot: *f32, fx: *f32, fy: *f32, fz: *f32
) void {

    var r_buf = @zeros([C_BUF_SIZE]f32);
    compute_solid_harmonics(dx, dy, dz, &r_buf);

    var p_acc: f32 = 0.0;
    var gx: f32 = 0.0;
    var gy: f32 = 0.0;
    var gz: f32 = 0.0;

    var idx: u16 = 0;
    for (@range(i16, P + 1)) |m| {
        const w: f32 = if (m == 0) 1.0 else 2.0;
        for (@range(i16, m, P + 1, 1)) |l| {
            const l_r = l_coeffs.*[idx * 2];
            const l_i = l_coeffs.*[idx * 2 + 1];
            const r_r = r_buf[idx * 2];
            const r_i = r_buf[idx * 2 + 1];

            // potential
            p_acc += w * (l_r * r_r - l_i * r_i);

            // gradient basis: R_{l-1}^{m-1}, R_{l-1}^{m+1}, R_{l-1}^m
            var b1_r: f32 = 0.0; var b1_i: f32 = 0.0;
            var b2_r: f32 = 0.0; var b2_i: f32 = 0.0;
            var bz_r: f32 = 0.0; var bz_i: f32 = 0.0;
            R_signed(&r_buf, l - 1, m - 1, &b1_r, &b1_i);
            R_signed(&r_buf, l - 1, m + 1, &b2_r, &b2_i);
            R_signed(&r_buf, l - 1, m, &bz_r, &bz_i);

            // dRx = -0.5 b1 + 0.5 b2
            const dRx_r = -0.5 * b1_r + 0.5 * b2_r;
            const dRx_i = -0.5 * b1_i + 0.5 * b2_i;
            // dRy = -0.5i b1 - 0.5i b2  => multiply (b1+b2) by -0.5i
            //   (-0.5i)(a_r + i a_i) = 0.5 a_i - 0.5i a_r
            const sum_r = b1_r + b2_r;
            const sum_i = b1_i + b2_i;
            const dRy_r = 0.5 * sum_i;
            const dRy_i = -0.5 * sum_r;
            // dRz = bz
            const dRz_r = bz_r;
            const dRz_i = bz_i;

            // accumulate w * Re(L * dR) = w (l_r dR_r - l_i dR_i)
            gx += w * (l_r * dRx_r - l_i * dRx_i);
            gy += w * (l_r * dRy_r - l_i * dRy_i);
            gz += w * (l_r * dRz_r - l_i * dRz_i);

            idx += 1;
        }
    }

    pot.* = p_acc;
    // Force = +grad(phi): the convention of P2P (apply in pe.csl) and of the
    // direct N-body reference. (It returned -grad(phi) before, i.e. the far
    // field had the opposite sign of the near field.)
    fx.* = gx;
    fy.* = gy;
    fz.* = gz;
}
