// kernels.csl - FMM mathematical kernels (2.5D), PACKED SIGNS
//
// Reused UNCHANGED from the 3D implementation: the translation operators
// (M2M/M2L/L2L), the solid-harmonics recurrences, and the packed-sign decode
// are all geometry-independent. They depend only on the relative translation
// vector between two cells and on the expansion order P, never on how cells are
// mapped onto the PE mesh. An M2L between two cubes separated by (+2,-1,0) uses
// the same matrix in 3D and in 2.5D. Only the communication layer changes.
//
// Packed signs: the four sign arrays (sign_rr/ri/ir/ii) are packed into a
// single value, 4 bits per entry:
//   bit 0 = sign_rr (1 = negative, 0 = positive)
//   bit 1 = sign_ri
//   bit 2 = sign_ir
//   bit 3 = sign_ii
//
// Runtime decode uses @bitcast from u32 to f32 to avoid branches:
//   float +1.0 = 0x3F800000
//   float -1.0 = 0xBF800000
// The two differ only in bit 31, so for a "negative" flag in {0,1}:
//   float = bitcast<f32>(0x3F800000 | (negative << 31))
//
// NOTE on M2L_N_ENTRIES: this parameter is DERIVED from the table generator,
// not hand-coded. For P=4 the generator emits 375 M2L entries (M2M = L2L = 92).
// constants25d.csl and the generated data blob must agree with the generator by
// construction; do not hand-edit this number.

param P: u16;
param M2M_N_ENTRIES: u16;
param M2L_N_ENTRIES: u16;
param L2L_N_ENTRIES: u16;
param N_BUCKETS: u16;
param P2P_PAYLOAD_SIZE: u16;

const N_COEFFS: u16 = (P + 1) * (P + 2) / 2;
const C_BUF_SIZE: u16 = N_COEFFS * 2;

const N_COEFFS_M2L: u16 = (2*P+1) * (2*P+2) / 2;
const C_BUF_M2L_SIZE: u16 = N_COEFFS_M2L * 2;

const math = @import_module("<math>");

const FLOAT_PLUS_ONE_BITS:  u32 = 0x3F800000;
const FLOAT_MINUS_ONE_BITS: u32 = 0xBF800000;

// Decode a single sign from the packed value.
// signs: holds 4 signs in bits 0..3.
// bit_idx: 0..3 (0 = rr, 1 = ri, 2 = ir, 3 = ii).
// Returns +1.0 if the bit is 0, -1.0 if the bit is 1.
fn decode_sign(signs: u16, bit_idx: u16) f32 {
    const negative: u32 = @as(u32, (signs >> bit_idx) & 1);
    const sign_bits: u32 = FLOAT_PLUS_ONE_BITS | (negative << 31);
    return @bitcast(f32, sign_bits);
}


// --- Solid Harmonics Computation ---
//
// Cartesian recurrence for solid harmonics up to order P. No trigonometric
// calls: the WSE-3 has no trig unit. Real/imaginary parts are interleaved in
// the output buffer (index 2k = real, 2k+1 = imag), ordered by (l,m) as given
// by get_mem_idx in the generator. This ordering is the shared contract between
// the operator tables and every buffer the kernels read or write.

fn compute_solid_harmonics(dx: f32, dy: f32, dz: f32, buf: *[C_BUF_SIZE]f32) void {

    for (@range(u16, C_BUF_SIZE)) |i| {
        buf.*[i] = 0.0;
    }

    var r2: f32 = dx * dx + dy * dy + dz * dz;

    var mm_r: f32 = 1.0;
    var mm_c: f32 = 0.0;

    var i_m: u16 = 0;

    for (@range(i16, P + 1)) |m| {

        if (m > 0) {
            var k_diag: f32 = -1.0 / (2.0 * @as(f32, m));
            var temp_r: f32 = k_diag * (dx * mm_r - dy * mm_c);
            var temp_c: f32 = k_diag * (dy * mm_r + dx * mm_c);
            mm_r = temp_r;
            mm_c = temp_c;
        }

        buf.*[i_m] = mm_r;
        buf.*[i_m + 1] = mm_c;
        i_m += 2;

        var prev2_r: f32 = 0.0;
        var prev2_c: f32 = 0.0;
        var prev1_r: f32 = mm_r;
        var prev1_c: f32 = mm_c;

        for (@range(i16, m + 1, P + 1, 1)) |l| {

            var k_lm: f32 = 1.0 / @as(f32, l * l - m * m);
            var z_k: f32 = (2.0 * @as(f32, l) - 1.0) * dz;

            var current_r: f32 = k_lm * (z_k * prev1_r - r2 * prev2_r);
            var current_c: f32 = k_lm * (z_k * prev1_c - r2 * prev2_c);

            buf.*[i_m] = current_r;
            buf.*[i_m + 1] = current_c;
            i_m += 2;

            prev2_r = prev1_r;
            prev2_c = prev1_c;
            prev1_r = current_r;
            prev1_c = current_c;
        }
    }
}


// Same recurrence, extended to order 2P. M2L needs the translation-vector
// expansion at double order: N_COEFFS_M2L = (2P+1)(2P+2)/2.
fn compute_solid_harmonics_2p(dx: f32, dy: f32, dz: f32, buf: *[C_BUF_M2L_SIZE]f32) void {
    for (@range(u16, C_BUF_M2L_SIZE)) |i| {
        buf.*[i] = 0.0;
    }

    var r2: f32 = dx * dx + dy * dy + dz * dz;
    var mm_r: f32 = 1.0;
    var mm_c: f32 = 0.0;
    var i_m: u16 = 0;

    const P2: i16 = 2 * @as(i16, P);

    for (@range(i16, P2 + 1)) |m| {
        if (m > 0) {
            var k_diag: f32 = -1.0 / (2.0 * @as(f32, m));
            var temp_r: f32 = k_diag * (dx * mm_r - dy * mm_c);
            var temp_c: f32 = k_diag * (dy * mm_r + dx * mm_c);
            mm_r = temp_r;
            mm_c = temp_c;
        }

        buf.*[i_m] = mm_r;
        buf.*[i_m + 1] = mm_c;
        i_m += 2;

        var prev2_r: f32 = 0.0;
        var prev2_c: f32 = 0.0;
        var prev1_r: f32 = mm_r;
        var prev1_c: f32 = mm_c;

        for (@range(i16, m + 1, P2 + 1, 1)) |l| {
            var k_lm: f32 = 1.0 / @as(f32, l * l - m * m);
            var z_k: f32 = (2.0 * @as(f32, l) - 1.0) * dz;

            var current_r: f32 = k_lm * (z_k * prev1_r - r2 * prev2_r);
            var current_c: f32 = k_lm * (z_k * prev1_c - r2 * prev2_c);

            buf.*[i_m] = current_r;
            buf.*[i_m + 1] = current_c;
            i_m += 2;

            prev2_r = prev1_r;
            prev2_c = prev1_c;
            prev1_r = current_r;
            prev1_c = current_c;
        }
    }
}


// --- M2M Translation (PACKED SIGNS) ---
//
// Pure function: translates a child multipole into its parent using the
// precomputed sparse table (offsets / child_indices / v_indices / signs). It
// knows nothing about where the data physically lives. In 2.5D the caller has
// already brought the source expansion into local SRAM (via a plane exchange);
// the accumulation here is identical to 3D.

// --- Unified sparse translation (M2M / M2L / L2L) ---
//
// The three operators (M2M upward, M2L, L2L downward) are the SAME sparse
// translation of one expansion through a precomputed CSR operator table
// (offsets + source/v indices + packed signs). They were three byte-identical
// copies differing only in the array-length type annotations and the v_buf size
// (90 for M2L, 30 for M2M/L2L). Collapsed into ONE function to cut .text (two
// copies of the heaviest arithmetic block + their inlined decode_sign sites
// removed). Pointers are unsized [*]T: the loop is CSR-bounded by `offsets`, so
// the compile-time array length is never used in the body. Math is byte-for-byte
// identical to the three originals — verified numerically to rel ~1e-15.
//   src_buf = the source expansion (child for M2M, source for M2L, parent for
//   L2L); tgt_buf = the target it accumulates (+=) into; v_buf = translation-
//   vector harmonics (30 floats for M2M/L2L, 90 for M2L).
fn translate(
    v_buf: [*]f32,
    src_buf: [*]f32,
    tgt_buf: [*]f32,
    offsets: [*]u16,
    src_indices: [*]u16,
    v_indices: [*]u16,
    signs: [*]u32
) void {
    for (@range(u16, N_COEFFS)) |f_idx| {
        var accum_r: f32 = 0.0;
        var accum_i: f32 = 0.0;
        const start_idx: u16 = offsets[f_idx];
        const end_idx: u16 = offsets[f_idx + 1];
        for (@range(u16, start_idx, end_idx, 1)) |i| {
            const ci: u16 = src_indices[i];
            const c_r: f32 = src_buf[ci];
            const c_i: f32 = src_buf[ci + 1];
            const vi: u16 = v_indices[i];
            const v_r: f32 = v_buf[vi];
            const v_i: f32 = v_buf[vi + 1];
            const s: u16 = @as(u16, signs[i] & 0xFFFF);
            const s_rr: f32 = decode_sign(s, 0);
            const s_ri: f32 = decode_sign(s, 1);
            const s_ir: f32 = decode_sign(s, 2);
            const s_ii: f32 = decode_sign(s, 3);
            accum_r += s_rr * c_r * v_r + s_ri * c_i * v_i;
            accum_i += s_ir * c_r * v_i + s_ii * c_i * v_r;
        }
        const p_idx: u16 = f_idx * 2;
        tgt_buf[p_idx] += accum_r;
        tgt_buf[p_idx + 1] += accum_i;
    }
}


// --- Memory index for (l,m) in a C_BUF_SIZE buffer (matches get_mem_idx) ---
// Returns the FLOAT index of the real part of R_l^m (imag is +1). For m<0 or
// |m|>l or l<0 the caller must handle out-of-range (returns 0, caller guards).
fn lm_index(l: i16, m: i16) u16 {
    var pos: u16 = 0;
    var mm: i16 = 0;
    const Pi: i16 = @as(i16, P);
    while (mm < m) {
        // All operands in i16 to avoid a u16/i16 mix; result is always >= 1.
        pos += @as(u16, Pi + 1 - mm);
        mm += 1;
    }
    pos += @as(u16, l - m);
    return pos * 2;
}

// Signed access to R_l^m with the conjugate relation for m<0:
//   R_l^{-m} = (-1)^m conj(R_l^m)
// Writes (re,im) into out_r/out_i; zero if l<0 or |m|>l.
fn R_signed(r_buf: *[C_BUF_SIZE]f32, l: i16, m: i16, out_r: *f32, out_i: *f32) void {
    var am: i16 = if (m < 0) -m else m;
    if (l < 0 or am > l) {
        out_r.* = 0.0; out_i.* = 0.0;
        return;
    }
    const base: u16 = lm_index(l, am);
    const rr: f32 = r_buf.*[base];
    const ri: f32 = r_buf.*[base + 1];
    if (m >= 0) {
        out_r.* = rr; out_i.* = ri;
    } else {
        // (-1)^m conj : for m<0, factor (-1)^{am}, conjugate flips imag sign
        const sgn: f32 = if (am % 2 == 0) 1.0 else -1.0;
        out_r.* = sgn * rr;
        out_i.* = -sgn * ri;
    }
}


// --- L2P Evaluation (potential AND forces) ---
//
// Potential:  phi = sum_lm w (L_r R_r - L_i R_i), w = 1 (m=0) else 2.
// Force = -grad(phi), using the verified gradient relations (this normalization,
// confirmed numerically to ~1e-11):
//   dR_l^m/dx = -0.5 R_{l-1}^{m-1} + 0.5 R_{l-1}^{m+1}
//   dR_l^m/dy = -0.5i R_{l-1}^{m-1} - 0.5i R_{l-1}^{m+1}
//   dR_l^m/dz =        R_{l-1}^m
// with R_l^{-m} = (-1)^m conj(R_l^m).
fn evaluate_l2p(
    dx: f32, dy: f32, dz: f32,
    l_coeffs: *[C_BUF_SIZE]f32,
    pot: *f32, fx: *f32, fy: *f32, fz: *f32
) void {

    var r_buf = @zeros([C_BUF_SIZE]f32);
    compute_solid_harmonics(dx, dy, dz, &r_buf);

    var p_acc: f32 = 0.0;
    var gx: f32 = 0.0;
    var gy: f32 = 0.0;
    var gz: f32 = 0.0;

    var idx: u16 = 0;
    for (@range(i16, P + 1)) |m| {
        const w: f32 = if (m == 0) 1.0 else 2.0;
        for (@range(i16, m, P + 1, 1)) |l| {
            const l_r = l_coeffs.*[idx * 2];
            const l_i = l_coeffs.*[idx * 2 + 1];
            const r_r = r_buf[idx * 2];
            const r_i = r_buf[idx * 2 + 1];

            // potential
            p_acc += w * (l_r * r_r - l_i * r_i);

            // gradient basis: R_{l-1}^{m-1}, R_{l-1}^{m+1}, R_{l-1}^m
            var b1_r: f32 = 0.0; var b1_i: f32 = 0.0;
            var b2_r: f32 = 0.0; var b2_i: f32 = 0.0;
            var bz_r: f32 = 0.0; var bz_i: f32 = 0.0;
            R_signed(&r_buf, l - 1, m - 1, &b1_r, &b1_i);
            R_signed(&r_buf, l - 1, m + 1, &b2_r, &b2_i);
            R_signed(&r_buf, l - 1, m, &bz_r, &bz_i);

            // dRx = -0.5 b1 + 0.5 b2
            const dRx_r = -0.5 * b1_r + 0.5 * b2_r;
            const dRx_i = -0.5 * b1_i + 0.5 * b2_i;
            // dRy = -0.5i b1 - 0.5i b2  => multiply (b1+b2) by -0.5i
            //   (-0.5i)(a_r + i a_i) = 0.5 a_i - 0.5i a_r
            const sum_r = b1_r + b2_r;
            const sum_i = b1_i + b2_i;
            const dRy_r = 0.5 * sum_i;
            const dRy_i = -0.5 * sum_r;
            // dRz = bz
            const dRz_r = bz_r;
            const dRz_i = bz_i;

            // accumulate w * Re(L * dR) = w (l_r dR_r - l_i dR_i)
            gx += w * (l_r * dRx_r - l_i * dRx_i);
            gy += w * (l_r * dRy_r - l_i * dRy_i);
            gz += w * (l_r * dRz_r - l_i * dRz_i);

            idx += 1;
        }
    }

    pot.* = p_acc;
    // Force = -grad(phi).
    fx.* = -gx;
    fy.* = -gy;
    fz.* = -gz;
}


// --- P2P Evaluation ---
//
// Direct pairwise interaction between a target body and a set of remote bodies.
//
// TODO(evaluation-phase): verify the force sign convention. Here dx = rx - tx
// (source minus target). This must be consistent with how the P2P contribution
// is combined with the L2P contribution (which will use the opposite, target
// minus source, convention) so the two add rather than cancel. Check against a
// direct N-body reference when P2P+L2P are integrated.

fn evaluate_p2p(
    target_x: f32, target_y: f32, target_z: f32,
    remote_bodies: *[P2P_PAYLOAD_SIZE]f32,
    remote_count: u16,
    fx_out: *f32, fy_out: *f32, fz_out: *f32, pot_out: *f32
) void {
    var fx: f32 = 0.0;
    var fy: f32 = 0.0;
    var fz: f32 = 0.0;
    var pot: f32 = 0.0;

    for (@range(u16, remote_count)) |i| {
        const base: u16 = i * 4;
        const rx: f32 = remote_bodies.*[base];
        const ry: f32 = remote_bodies.*[base + 1];
        const rz: f32 = remote_bodies.*[base + 2];
        const rq: f32 = remote_bodies.*[base + 3];

        const dx = rx - target_x;
        const dy = ry - target_y;
        const dz = rz - target_z;

        const r2 = dx * dx + dy * dy + dz * dz;
        if (r2 > 1e-10) {
            const r_inv = 1.0 / math.sqrt(r2);
            const r_inv3 = r_inv * r_inv * r_inv;

            const f_factor = rq * r_inv3;
            fx += f_factor * dx;
            fy += f_factor * dy;
            fz += f_factor * dz;
            pot += rq * r_inv;
        }
    }

    fx_out.* = fx;
    fy_out.* = fy;
    fz_out.* = fz;
    pot_out.* = pot;
}
