// constants.csl - 2.5D FMM constants
//
// Split into two clearly separated blocks:
//
//   [A] ALGEBRAIC / GEOMETRIC constants. Foundational, geometry-independent or
//       derived from the table generator. Fixed now. These are reused from the
//       3D implementation or recomputed; none depend on the communication
//       design.
//
//   [B] COMMUNICATION constants (header layout, colors, queues, routing buffer
//       sizes, task ids). These depend on the transport design.


// ===========================================================================
// IMPORTED PARAMETERS (from layout)
// ===========================================================================
param cells_per_side : u16;   // C: domain side in leaf cells = PE mesh side
param prob_range : f32;       // physical edge length of the cubic domain
param max_bodies_pe : u16;    // max bodies in one leaf cell's body buffer
param cell_size : f32;        // leaf-cell edge = prob_range / C


// ===========================================================================
// [A] ALGEBRAIC / GEOMETRIC CONSTANTS  (fixed)
// ===========================================================================

// --- Tree geometry ---
// C == 2**TREE_H. For C = 16, TREE_H = 4: four levels above the leaves.
const TREE_H : u16 = 4;

// Box edge length at each tree level. Index l gives the edge of a level-l box.
// Level 0 = root (whole domain), level TREE_H = leaf cell.
const box_size_at_level = [5]f32{
    prob_range,              // level 0 (root)
    prob_range / 2.0,        // level 1
    prob_range / 4.0,        // level 2
    prob_range / 8.0,        // level 3
    prob_range / 16.0,       // level 4 (leaf, == cell_size for C=16)
};

// --- Multipole / expansion constants ---
const P : u16 = 4;
const N_COEFFS : u16 = (P + 1) * (P + 2) / 2;          // 15
const C_BUF_SIZE : u16 = N_COEFFS * 2;                 // 30 (interleaved re/im)
const N_COEFFS_V : u16 = (2*P + 1) * (2*P + 2) / 2;    // 45
const C_BUF_M2L_SIZE : u16 = N_COEFFS_V * 2;           // 90

// --- Operator table sizes ---
// DERIVED FROM THE GENERATOR (verified for P=4). The generated data blob and
// kernels.csl must agree with the generator by construction. Do NOT hand-edit.
//   M2M = L2L = 92 entries, M2L = 375 entries.
const M2M_N_ENTRIES : u16 = 92;
const M2L_N_ENTRIES : u16 = 375;
const L2L_N_ENTRIES : u16 = 105;   // corrected L2L table (fmm_tables.gen_l2l_tables)

// Number of CSR-style buckets in the operator tables: one per target coeff,
// plus the trailing offset. offsets[-1] == N_ENTRIES for each table.
const N_BUCKETS : u16 = N_COEFFS + 1;                  // 16

// (Body layout: see COLUMN BODIES in pe.csl.)


// ===========================================================================
// [B] COMMUNICATION CONSTANTS  (serpentine software-routed transport)
// ===========================================================================
//
// Every hop is a single RAMP -> neighbour transfer; the CE forwards. See the
// TRANSPORT and SERPENTINE PASS sections of pe.csl.

// --- Message types (2 bits, informational: the receiver knows its pass) ---
const MSG_M2M : u16 = 0;
const MSG_M2L : u16 = 1;
const MSG_L2L : u16 = 2;
const MSG_P2P : u16 = 3;

// --- Message granularity: K boxes per message ---------------------------
// A message carries K boxes (consecutive z) of one source column. Levels with
// more than K boxes along Z split into ceil(nz/K) messages:
//   K=4: leaf (nz=16): 4 messages  level3 (nz=8): 2  level2 (nz=4): 1
// MSG_SIZE = 4*30+1 = 121. zcount fits in 3 bits.
const K_CUBES : u16 = 4;

// --- Header layout (32 bits) --------------------------------------------
//   bits 31..28 : src_x (4)        -> PE that originated the message
//   bits 27..24 : src_y (4)
//   bits 23..22 : msg_type (2)
//   bits 21..20 : level - 2 (2)    -> data level in [2,4]
//   bits 19..11 : hop (9)          -> hops travelled (forwarders rewrite it)
//   bits 10..8  : zcount (3)       -> boxes in this message (1..K_CUBES)
//   bits  7..4  : z_base (4)       -> first box z index in this message
//   bits  3..0  : reserved (4)
const SHIFT_SRC_X   : u16 = 28;
const SHIFT_SRC_Y   : u16 = 24;
const SHIFT_MSG_TYPE: u16 = 22;
const SHIFT_LEVEL   : u16 = 20;
const SHIFT_HOP     : u16 = 11;
const SHIFT_ZCOUNT  : u16 = 8;
const SHIFT_ZBASE   : u16 = 4;

const MASK_4BIT : u32 = 0xF;
const MASK_3BIT : u32 = 0x7;
const MASK_2BIT : u32 = 0x3;
const MASK_9BIT : u32 = 0x1FF;
const HOP_CLEAR : u32 = 0xFFF007FF;      // header with the hop bits cleared

// --- Message sizes ------------------------------------------------------
const MSG_PAYLOAD_MAX : u16 = K_CUBES * C_BUF_SIZE;    // 4 * 30 = 120 floats
const MSG_SIZE : u16 = MSG_PAYLOAD_MAX + 1;            // 121 wavelets

// --- Routing colors (8 = 4 directions x 2 parity) -----------------------
// The even/odd parity split is a FABRIC requirement: adjacent PEs must use
// different colors for the same logical direction so a color does not overlap
// itself on consecutive hops.
param color_e_even : color;
param color_e_odd  : color;
param color_w_even : color;
param color_w_odd  : color;
param color_n_even : color;
param color_n_odd  : color;
param color_s_even : color;
param color_s_odd  : color;

// --- Input / output queues (one per direction code) ----------------------
// rx code d uses iq d+2, tx code d uses oq d+2 (memcpy owns queues 0, 1).
const e_iq = @get_input_queue(2);
const w_iq = @get_input_queue(3);
const n_iq = @get_input_queue(4);
const s_iq = @get_input_queue(5);

const e_oq = @get_output_queue(2);
const w_oq = @get_output_queue(3);
const n_oq = @get_output_queue(4);
const s_oq = @get_output_queue(5);


// ===========================================================================
// [B'] TASK IDs
// ===========================================================================
// Receive is an explicit async @mov32 drain that activates a completion LOCAL
// task per direction; one tx-completion local task per direction. Local task
// IDs 16..21 are reserved by the memcpy library, so we use <=15 and >=22.
const rx_complete_e_id : local_task_id = @get_local_task_id(8);
const rx_complete_w_id : local_task_id = @get_local_task_id(9);
const rx_complete_n_id : local_task_id = @get_local_task_id(10);
const rx_complete_s_id : local_task_id = @get_local_task_id(11);

const tx_complete_e_id : local_task_id = @get_local_task_id(22);
const tx_complete_w_id : local_task_id = @get_local_task_id(23);
const tx_complete_n_id : local_task_id = @get_local_task_id(24);
const tx_complete_s_id : local_task_id = @get_local_task_id(25);
