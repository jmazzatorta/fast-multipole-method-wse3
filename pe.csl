// pe.csl - 2.5D FMM, PER-PE PROGRAM
//
// Mapping (2.5D): PE(pe_x, pe_y) owns a COLUMN of C leaf cells stacked along
// Z; (pe_x, pe_y) is the plane position, z = 0..C-1 is local. A leaf cell is
// the 1x1x1 cube (pe_x, pe_y, z); multipoles are fully 3D, one per cube.
//
// Column resident state (separate buffers per level, each an array along Z;
// persistent for the whole algorithm). Nodes along Z at level l = 2**l:
//   level 4 (leaf): C   nodes   -> m_lvl4 / l_lvl4
//   level 3       : C/2 nodes   -> m_lvl3 / l_lvl3
//   level 2       : C/4 nodes   -> m_lvl2 / l_lvl2
// Levels 1 and 0 are not stored: FMM has no M2L interactions there (M2L runs at
// levels 2..4 and L2L starts at level 2), so their expansions are never used.
//
// COMMUNICATION: one software-routed transport, the SERPENTINE PASS (modelled
// on the direct N-body reference). Every plane exchange of the algorithm is a
// pass of it: M2M 4->3, M2M 3->2, M2L at levels 4/3/2, L2L 2->3, L2L 3->4 and
// the P2P near field (body blocks of the 8 plane-neighbour columns).
//
// NOTE: the <simprint> debug-print module is not used (its inline byte loop
// forced --max-inlined-iterations up and cost .data.hi/.text).

// memcpy params struct from the layout. Declared untyped: the `comptime_struct`
// type annotation is not accepted by the current cslc (server 1.20.2).
param memcpy_params;
const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);

// --- GLOBAL PARAMETERS (from layout) ---
param cells_per_side : u16;   // C
param prob_range : f32;
param max_bodies_pe : u16;    // max bodies per leaf cell
param cell_size : f32;

// --- TOPOLOGY PARAMETERS (from layout) ---
// In 2.5D the PE's plane position IS its (x,y) identity: no Morton decode.
param pe_x_param : u16;
param pe_y_param : u16;
param parity_x : u16;   // pe_x % 2, for the even/odd color split
param parity_y : u16;   // pe_y % 2

// --- ROUTING COLORS (from layout) ---
param color_e_even : color;
param color_e_odd  : color;
param color_w_even : color;
param color_w_odd  : color;
param color_n_even : color;
param color_n_odd  : color;
param color_s_even : color;
param color_s_odd  : color;

// --- MODULES ---
const cons = @import_module("constants.csl", .{
    .cells_per_side = cells_per_side,
    .prob_range = prob_range,
    .max_bodies_pe = max_bodies_pe,
    .cell_size = cell_size,
    .color_e_even = color_e_even, .color_e_odd = color_e_odd,
    .color_w_even = color_w_even, .color_w_odd = color_w_odd,
    .color_n_even = color_n_even, .color_n_odd = color_n_odd,
    .color_s_even = color_s_even, .color_s_odd = color_s_odd,
});
const geom = @import_module("geometry.csl", .{
    .prob_range = prob_range,
    .cells_per_side = cells_per_side,
    .TREE_H = cons.TREE_H,
});
const kernels = @import_module("kernels.csl", .{
    .P = cons.P,
    .M2M_N_ENTRIES = cons.M2M_N_ENTRIES,
    .M2L_N_ENTRIES = cons.M2L_N_ENTRIES,
    .L2L_N_ENTRIES = cons.L2L_N_ENTRIES,
    .N_BUCKETS = cons.N_BUCKETS,
});

// --- RUNTIME POSITION ---
// Fixed for the whole column. Set by init_position (called in run_p2m).
var pe_x : u16 = 0;
var pe_y : u16 = 0;
var center_x : f32 = 0.0;   // (pe_x + 0.5) * cell_size, fixed for column
var center_y : f32 = 0.0;   // (pe_y + 0.5) * cell_size, fixed for column

// ===========================================================================
// OPERATOR TABLES (math block, loaded by host via memcpy; device buffers u32)
// ===========================================================================
// Identical to 3D: these are the reused, geometry-independent tables. Signs are
// 4 bits packed into a u32 (upper 16 bits zero, memcpy requires u32 device
// buffers). Same per PE (not scaling with C): ~4.46 KB.
export var m2m_offsets       = @zeros([cons.N_BUCKETS]u16);
export var m2m_child_indices = @zeros([cons.M2M_N_ENTRIES]u16);
export var m2m_v_indices     = @zeros([cons.M2M_N_ENTRIES]u16);
export var m2m_signs         = @zeros([cons.M2M_N_ENTRIES]u32);

export var m2l_offsets        = @zeros([cons.N_BUCKETS]u16);
export var m2l_source_indices = @zeros([cons.M2L_N_ENTRIES]u16);
export var m2l_v_indices      = @zeros([cons.M2L_N_ENTRIES]u16);
export var m2l_signs          = @zeros([cons.M2L_N_ENTRIES]u32);

export var l2l_offsets        = @zeros([cons.N_BUCKETS]u16);
export var l2l_source_indices = @zeros([cons.L2L_N_ENTRIES]u16);
export var l2l_v_indices      = @zeros([cons.L2L_N_ENTRIES]u16);
export var l2l_signs          = @zeros([cons.L2L_N_ENTRIES]u32);


// ===========================================================================
// COLUMN BODIES  (Option 1: fixed per-cell blocks)
// ===========================================================================
// Layout: C contiguous cell blocks, each
//   [ count (1 slot) | body_0 (x,y,z,q) | body_1 | ... | body_{max-1} ]
// Block stride = 1 + max_bodies_pe*4 (in u32 slots; floats bitcast to u32).
// Cell z's block starts at z * CELL_BLOCK.
// Worst-case memory equals the dense layout, so we take the simple one.
const CELL_BLOCK : u16 = 1 + max_bodies_pe * 4;
const BODIES_COL_LEN : u16 = cells_per_side * CELL_BLOCK;
export var bodies_col = @zeros([BODIES_COL_LEN]u32);

// P2P pass: a message carries P2P_CELLS whole cell blocks (count + bodies), as
// many as fit in the payload, at most 7 (3-bit zcount). serp_tables.p2p_cells
// must give the same number.
const P2P_CELLS_FIT : u16 = cons.MSG_PAYLOAD_MAX / CELL_BLOCK;
const P2P_CELLS : u16 = if (P2P_CELLS_FIT > 7) 7 else P2P_CELLS_FIT;

// ===========================================================================
// RESIDENT COLUMN STATE  (separate buffers per level, array along Z)
// ===========================================================================
// Flattened: level l buffer holds (2**l) expansions, each C_BUF_SIZE floats.
// Node k at level l lives at offset k * C_BUF_SIZE.
//
// Nodes along Z: lvl4=C, lvl3=C/2, lvl2=C/4 (16, 8, 4 for C=16). Sized from
// cells_per_side so the file is C-generic.

const NZ4 : u16 = cells_per_side;          // 16
const NZ3 : u16 = cells_per_side / 2;      // 8
const NZ2 : u16 = cells_per_side / 4;      // 4

// Multipole (M) buffers, upward pass. m_lvl4 is the P2M output.
// Not exported: host verification of intermediate multipoles was dropped to
// relieve per-PE code/symbol-table pressure (see layout.csl).
var m_lvl4 = @zeros([NZ4 * cons.C_BUF_SIZE]f32);
var m_lvl3 = @zeros([NZ3 * cons.C_BUF_SIZE]f32);
var m_lvl2 = @zeros([NZ2 * cons.C_BUF_SIZE]f32);

// Local (L) buffers, downward pass. Filled in phases (c)/(d).
var l_lvl4 = @zeros([NZ4 * cons.C_BUF_SIZE]f32);
var l_lvl3 = @zeros([NZ3 * cons.C_BUF_SIZE]f32);
var l_lvl2 = @zeros([NZ2 * cons.C_BUF_SIZE]f32);

// ===========================================================================
// SCRATCH  (fixed, recycled per translation; does NOT grow with C)
// ===========================================================================
// contrib_buf: solid harmonics of one body (used by P2M).
// v_buf / v_buf_m2l: translation-vector harmonics (used by M2M/L2L and M2L).
var contrib_buf = @zeros([cons.C_BUF_SIZE]f32);
var v_buf = @zeros([cons.C_BUF_SIZE]f32);
var v_buf_m2l = @zeros([cons.C_BUF_M2L_SIZE]f32);

// ===========================================================================
// RESULTS  (per body in the column: fx, fy, fz, pot)
// ===========================================================================
// One block of max_bodies_pe*4 per cell, same per-cell stride idea as bodies.
export var forces_col = @zeros([cells_per_side * max_bodies_pe * 4]f32);
export var fmm_done = @zeros([1]u32);



// ===========================================================================
// ===========================================================================
//                    TRANSPORT  (single-hop, software-routed)
// ===========================================================================
// ===========================================================================
//
// Every hop is a RAMP -> neighbour transfer on a parity color; the CE does all
// forwarding. A PE uses, for an OUTGOING direction, the color of its own parity
// on that axis; the neighbour (opposite parity) receives it on the same color.
// One rx buffer and one tx buffer per direction, MSG_SIZE words each.
//
// Direction codes:
//   tx: direction the PE sends to              0=E 1=W 2=N 3=S
//   rx: direction of TRAVEL of incoming traffic 0=eastbound (from the W
//       neighbour) 1=westbound (from E) 2=northbound (from S) 3=southbound
//       (from N); an rx code equals the tx code of the neighbour sending to us.
// Queue numbers: rx code d uses iq d+2, tx code d uses oq d+2 and microthread
// d+2. A drain and a send with the same code therefore share a microthread and
// must never be active together (the serpentine pass guarantees it).

const c_e_out = if (parity_x == 0) cons.color_e_even else cons.color_e_odd;
const c_w_out = if (parity_x == 0) cons.color_w_even else cons.color_w_odd;
const c_n_out = if (parity_y == 0) cons.color_n_even else cons.color_n_odd;
const c_s_out = if (parity_y == 0) cons.color_s_even else cons.color_s_odd;

// INCOMING colors: the neighbour that sends to us has the opposite parity, so
// it sends on the OTHER parity color of the SAME direction family (eastbound
// traffic reaches us from our WEST neighbour on its e_out color). Same mapping
// as the transport validated on device in freeroute; every link of the mesh
// checked by script.
const c_e_in = if (parity_x == 0) cons.color_e_odd  else cons.color_e_even;
const c_w_in = if (parity_x == 0) cons.color_w_odd  else cons.color_w_even;
const c_n_in = if (parity_y == 0) cons.color_n_odd  else cons.color_n_even;
const c_s_in = if (parity_y == 0) cons.color_s_odd  else cons.color_s_even;

var rx_buf_e = @zeros([cons.MSG_SIZE]f32);
var rx_buf_w = @zeros([cons.MSG_SIZE]f32);
var rx_buf_n = @zeros([cons.MSG_SIZE]f32);
var rx_buf_s = @zeros([cons.MSG_SIZE]f32);
var tx_buf_e = @zeros([cons.MSG_SIZE]f32);
var tx_buf_w = @zeros([cons.MSG_SIZE]f32);
var tx_buf_n = @zeros([cons.MSG_SIZE]f32);
var tx_buf_s = @zeros([cons.MSG_SIZE]f32);
var rx_armed = @zeros([4]u16);    // per rx code: an async drain is armed

// Color is bound to the queue via @initialize_queue (comptime).
const tx_dsd_e = @get_dsd(fabout_dsd, .{ .extent = cons.MSG_SIZE, .output_queue = cons.e_oq });
const tx_dsd_w = @get_dsd(fabout_dsd, .{ .extent = cons.MSG_SIZE, .output_queue = cons.w_oq });
const tx_dsd_n = @get_dsd(fabout_dsd, .{ .extent = cons.MSG_SIZE, .output_queue = cons.n_oq });
const tx_dsd_s = @get_dsd(fabout_dsd, .{ .extent = cons.MSG_SIZE, .output_queue = cons.s_oq });
const rx_dsd_e = @get_dsd(fabin_dsd, .{ .extent = cons.MSG_SIZE, .input_queue = cons.e_iq });
const rx_dsd_w = @get_dsd(fabin_dsd, .{ .extent = cons.MSG_SIZE, .input_queue = cons.w_iq });
const rx_dsd_n = @get_dsd(fabin_dsd, .{ .extent = cons.MSG_SIZE, .input_queue = cons.n_iq });
const rx_dsd_s = @get_dsd(fabin_dsd, .{ .extent = cons.MSG_SIZE, .input_queue = cons.s_iq });

// --- Header (32 bits, see constants.csl) -----------------------------------
// The SOURCE PE is written once by the origin; forwarders only rewrite hop.
fn build_header(src_x: u16, src_y: u16, msg_type: u16, level: u16,
                hop: u16, zcount: u16, zbase: u16) u32 {
    var h : u32 = (@as(u32, src_x) & cons.MASK_4BIT) << cons.SHIFT_SRC_X;
    h |= (@as(u32, src_y) & cons.MASK_4BIT) << cons.SHIFT_SRC_Y;
    h |= (@as(u32, msg_type) & cons.MASK_2BIT) << cons.SHIFT_MSG_TYPE;
    h |= (@as(u32, level - 2) & cons.MASK_2BIT) << cons.SHIFT_LEVEL;
    h |= (@as(u32, hop) & cons.MASK_9BIT) << cons.SHIFT_HOP;
    h |= (@as(u32, zcount) & cons.MASK_3BIT) << cons.SHIFT_ZCOUNT;
    h |= (@as(u32, zbase) & cons.MASK_4BIT) << cons.SHIFT_ZBASE;
    return h;
}
fn hdr_src_x(h: u32) u16 { return @as(u16, (h >> cons.SHIFT_SRC_X) & cons.MASK_4BIT); }
fn hdr_src_y(h: u32) u16 { return @as(u16, (h >> cons.SHIFT_SRC_Y) & cons.MASK_4BIT); }
fn hdr_hop(h: u32) u16 { return @as(u16, (h >> cons.SHIFT_HOP) & cons.MASK_9BIT); }
fn hdr_zcount(h: u32) u16 { return @as(u16, (h >> cons.SHIFT_ZCOUNT) & cons.MASK_3BIT); }
fn hdr_zbase(h: u32) u16 { return @as(u16, (h >> cons.SHIFT_ZBASE) & cons.MASK_4BIT); }
fn hdr_with_hop(h: u32, hop: u16) u32 {
    return (h & cons.HOP_CLEAR) | ((@as(u32, hop) & cons.MASK_9BIT) << cons.SHIFT_HOP);
}

fn rx_buf_base(dir: u16) [*]f32 {
    if (dir == 1) { return @ptrcast([*]f32, &rx_buf_w[0]); }
    if (dir == 2) { return @ptrcast([*]f32, &rx_buf_n[0]); }
    if (dir == 3) { return @ptrcast([*]f32, &rx_buf_s[0]); }
    return @ptrcast([*]f32, &rx_buf_e[0]);
}
fn tx_buf_base(dir: u16) [*]f32 {
    if (dir == 1) { return @ptrcast([*]f32, &tx_buf_w[0]); }
    if (dir == 2) { return @ptrcast([*]f32, &tx_buf_n[0]); }
    if (dir == 3) { return @ptrcast([*]f32, &tx_buf_s[0]); }
    return @ptrcast([*]f32, &tx_buf_e[0]);
}

// Write header + plen payload floats from `src` into a tx buffer.
fn fill_tx(buf: [*]f32, header: u32, src: [*]f32, plen: u16) void {
    buf[0] = @bitcast(f32, header);
    // Build both mem1d DSDs over a fixed named array (template for @get_dsd),
    // then rebase each to its real runtime pointer.
    var d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{cons.MSG_PAYLOAD_MAX} -> tx_buf_e[i] });
    d = @set_dsd_base_addr(d, @ptrcast([*]f32, &buf[1]));
    const dl = @set_dsd_length(d, plen);
    var s = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{cons.MSG_PAYLOAD_MAX} -> tx_buf_e[i] });
    s = @set_dsd_base_addr(s, src);
    const sl = @set_dsd_length(s, plen);
    @fmovs(dl, sl);
}

// Send MSG_SIZE words starting at `buf` towards tx code `dir`. The fabout DSD,
// ut_id and completion task are comptime per direction, hence the 4-way tail.
fn send_raw(dir: u16, buf: [*]f32) void {
    var d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{cons.MSG_SIZE} -> tx_buf_e[i] });
    d = @set_dsd_base_addr(d, buf);
    if (dir == 0) {
        @mov32(tx_dsd_e, d, .{ .async = true, .ut_id = @get_ut_id(2), .activate = cons.tx_complete_e_id });
    } else if (dir == 1) {
        @mov32(tx_dsd_w, d, .{ .async = true, .ut_id = @get_ut_id(3), .activate = cons.tx_complete_w_id });
    } else if (dir == 2) {
        @mov32(tx_dsd_n, d, .{ .async = true, .ut_id = @get_ut_id(4), .activate = cons.tx_complete_n_id });
    } else {
        @mov32(tx_dsd_s, d, .{ .async = true, .ut_id = @get_ut_id(5), .activate = cons.tx_complete_s_id });
    }
}

// Arm an async drain of one whole message into the rx buffer of rx code `dir`.
fn arm_drain(dir: u16) void {
    if (rx_armed[dir] == 1) return;
    rx_armed[dir] = 1;
    var d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{cons.MSG_SIZE} -> rx_buf_e[i] });
    d = @set_dsd_base_addr(d, rx_buf_base(dir));
    if (dir == 0) {
        @mov32(d, rx_dsd_e, .{ .async = true, .activate = cons.rx_complete_e_id });
    } else if (dir == 1) {
        @mov32(d, rx_dsd_w, .{ .async = true, .activate = cons.rx_complete_w_id });
    } else if (dir == 2) {
        @mov32(d, rx_dsd_n, .{ .async = true, .activate = cons.rx_complete_n_id });
    } else {
        @mov32(d, rx_dsd_s, .{ .async = true, .activate = cons.rx_complete_s_id });
    }
}

fn rx_done(dir: u16) void {
    rx_armed[dir] = 0;
    serp_on_rx(dir);
}
task rx_complete_e() void { rx_done(0); }
task rx_complete_w() void { rx_done(1); }
task rx_complete_n() void { rx_done(2); }
task rx_complete_s() void { rx_done(3); }
task tx_complete_e() void { serp_on_tx(0); }
task tx_complete_w() void { serp_on_tx(1); }
task tx_complete_n() void { serp_on_tx(2); }
task tx_complete_s() void { serp_on_tx(3); }

// ===========================================================================
// M2L MATH
// ===========================================================================
//
// One message carries zcount source-box multipoles (z indices zbase..) of the
// source column at plane box (sbx, sby); this PE's column is target box
// (tbx, tby). Both are in BOX units of `level`. For every (source, target) box
// pair in the FMM interaction list, translate the source multipole into the
// target's local expansion l_lvlN.
//
// INTERACTION LIST (2:1 octree): the two boxes are NOT adjacent
// (max |d| >= 2) and their PARENTS ARE adjacent (|parent difference| <= 1 on
// every axis). (The previous guard 2 <= max|d| <= 3 had no parent test and
// double-counted pairs already covered at the coarser level.)
// Translation vector: d = (target - source) * box_size_at_level[level].
fn apply_m2l(level: u16, tbx: u16, tby: u16, sbx: u16, sby: u16,
             zbase: u16, zcount: u16, payload: [*]f32) void {
    // Planar parent adjacency, decided once for the whole message.
    const tpx : i16 = @as(i16, tbx >> 1); const spx : i16 = @as(i16, sbx >> 1);
    const tpy : i16 = @as(i16, tby >> 1); const spy : i16 = @as(i16, sby >> 1);
    const dpx : i16 = tpx - spx; const dpy : i16 = tpy - spy;
    if (dpx < -1 or dpx > 1 or dpy < -1 or dpy > 1) return;

    const dxp : i16 = @as(i16, tbx) - @as(i16, sbx);
    const dyp : i16 = @as(i16, tby) - @as(i16, sby);
    const adx : i16 = if (dxp < 0) -dxp else dxp;
    const ady : i16 = if (dyp < 0) -dyp else dyp;
    const mxy : i16 = if (adx > ady) adx else ady;

    const nz : u16 = geom.grid_boxes(level);
    const l_target = l_level_ptr(level);
    const b_size : f32 = cons.box_size_at_level[level];

    for (@range(u16, zcount)) |ci| {
        const src_z : u16 = zbase + ci;
        const src_exp : [*]f32 = @ptrcast([*]f32, &payload[ci * cons.C_BUF_SIZE]);
        for (@range(u16, nz)) |tz| {
            const dz : i16 = @as(i16, tz) - @as(i16, src_z);
            const dpz : i16 = @as(i16, tz >> 1) - @as(i16, src_z >> 1);
            if (dpz < -1 or dpz > 1) continue;            // parents not adjacent
            const adz : i16 = if (dz < 0) -dz else dz;
            const mx : i16 = if (adz > mxy) adz else mxy;
            if (mx < 2) continue;                           // adjacent: near field

            var dist_x : f32 = 0.0; var dist_y : f32 = 0.0; var dist_z : f32 = 0.0;
            geom.get_physical_distances(dxp, dyp, dz, b_size, &dist_x, &dist_y, &dist_z);
            kernels.compute_irregular_harmonics_2p(dist_x, dist_y, dist_z, &v_buf_m2l);
            kernels.translate(
                @ptrcast([*]f32, &v_buf_m2l[0]),
                src_exp,
                @ptrcast([*]f32, &l_target.*[tz * cons.C_BUF_SIZE]),
                @ptrcast([*]u16, &m2l_offsets[0]),
                @ptrcast([*]u16, &m2l_source_indices[0]),
                @ptrcast([*]u16, &m2l_v_indices[0]),
                @ptrcast([*]u32, &m2l_signs[0]));
            serp_stats[4] += 1;     // applied translations (diagnostic)
        }
    }
}



// ===========================================================================
// SERPENTINE PASS  (the only communication mechanism)
// ===========================================================================
//
// The PEs of a pass form an open row-by-row serpentine; two streams run on it:
// FWD (increasing path position) and BWD (decreasing). The PATH, the in/out
// directions and all message COUNTS come from a host-built table
// (serp_tables.py, pushed into serp_tab), so the device never computes a route.
// The path of a level visits only the rows of that level's representatives
// (all rows at level 4, 1 in 2 at level 3, 1 in 4 at level 2); the PEs at the
// row ends carry it down the column. A PE off the path is idle in that pass.
//
// PASSES, in order (one host launch of run_pass each):
//   0 M2M43  senders: non level-3 reps send their m_lvl3 partial (2 msgs);
//            a level-3 rep ADDS those of its 2x2 block; then z-local 3 -> 2.
//   1 M2M32  senders: level-3, non level-2 reps send m_lvl2 (1 msg); a level-2
//            rep ADDS those of its 4x4 block.
//   2..4 M2L at level 4, 3, 2: every rep of the level sends its multipoles; a
//            rep of the level applies M2L for every pair in the interaction
//            list (plus the column-local pairs, at begin).
//   5 L2L23  level-2 reps send l_lvl2; a level-3 rep of the block COPIES it;
//            then every level-3 rep does z-local L2L 2 -> 3.
//   6 L2L34  level-3 reps send l_lvl3 (2 msgs); a PE of the 2x2 block COPIES
//            it; then every PE does z-local L2L 3 -> 4.
//   7 P2P    every PE sends its cell body blocks (P2P_CELLS per message); a PE
//            sums the direct interactions of its cells with the cells at
//            |dz| <= 1 of each plane-neighbour column (|dx|, |dy| <= 1); the
//            column-local part (dx = dy = 0) is done at begin.
// Each message carries zcount boxes (z indices zbase..) of the source column
// (P2P: zcount cell blocks).
//
// Per stream state machine (as the reference: one rx buffer, counters only,
// STRICT ALTERNATION of send and drain within a stream):
//   - own messages go out first, one at a time (out-direction tx buffer);
//   - only then is the drain armed; a drain is armed only while the stream's
//     tx is idle (the rx and tx of a stream may share a queue number, hence a
//     microthread; the reference serialized them for this reason). The two
//     streams of a PE never share a queue number, so FWD and BWD overlap;
//   - rx_complete: if hop < hmax, rewrite hop in the header and forward the
//     message straight from the rx buffer (no copy), then consume it (the math
//     overlaps the fabric send); the next drain is armed by tx_complete.
//     Otherwise consume and re-arm at once;
//   - done when drains == n_rx and emits == n_tx on both streams (counts from
//     the table); then the pass's completion action runs, the NEXT pass is
//     prepared (its messages may arrive before this PE's next launch) and the
//     step id is written to fmm_done.
// Verified in sim_serp.py for all 8 passes (rendezvous fabric, random task
// order, PEs beginning at random times; mutation-tested): no deadlock, exact
// counts, each PE gets exactly its window, every required sender delivered,
// source decoded correctly, never a drain and a send on one queue number.

const SERP_NF : u16 = 10;       // table fields per pass (see serp_tables.py)
const SERP_NPASS : u16 = 8;
const SF_IN0 : u16 = 0;  const SF_OUT0 : u16 = 1;  // FWD in / out direction
const SF_IN1 : u16 = 2;  const SF_OUT1 : u16 = 3;  // BWD in / out direction
const SF_NRX0 : u16 = 4; const SF_NTX0 : u16 = 5;
const SF_NRX1 : u16 = 6; const SF_NTX1 : u16 = 7;
const SF_NOWN : u16 = 8; const SF_HMAX : u16 = 9;
const DIR_NONE : u16 = 4;

const PASS_M2M43 : u16 = 0;
const PASS_M2M32 : u16 = 1;
const PASS_M2L4  : u16 = 2;
const PASS_M2L2  : u16 = 4;
const PASS_L2L23 : u16 = 5;
const PASS_L2L34 : u16 = 6;
const PASS_P2P   : u16 = 7;

export var serp_tab = @zeros([SERP_NPASS * SERP_NF]u16);
// serp_stats (reset when a pass is prepared; the host reads it after each pass):
//   [0] drains FWD [1] drains BWD [2] emits FWD [3] emits BWD
//   [4] work items (M2L translations / boxes added or copied / P2P
//       (target cell, source cell) pairs) [5] stray rx
//   [6] pass done flag [7] protocol errors
var serp_stats = @zeros([8]u32);
// Per-pass copy of serp_stats, written when the pass completes (serp_stats
// itself is reset by the preparation of the next pass before the host could
// read it). The host reads this once, at the end of the run.
var serp_stats_all = @zeros([SERP_NPASS * 8]u32);

var serp_active : u16 = 0;      // 1 while a pass is prepared or running
var serp_started : u16 = 0;     // 1 once this PE launched the pass (own sends)
var serp_done : u16 = 0;        // one-shot completion latch of the pass
var serp_pass : u16 = 0;
var serp_dlevel : u16 = 4;      // level of the data the pass sends
var serp_nown : u16 = 0;
var serp_hmax : u16 = 0;
// Per stream (index 0 = FWD, 1 = BWD):
var sp_in    = @zeros([2]u16);
var sp_out   = @zeros([2]u16);
var sp_nrx   = @zeros([2]u16);
var sp_ntx   = @zeros([2]u16);
var sp_drain = @zeros([2]u16);  // messages received
var sp_emit  = @zeros([2]u16);  // sends completed
var sp_own   = @zeros([2]u16);  // own messages launched
var sp_busy  = @zeros([2]u16);  // a send is in flight

// Level of the data each pass sends, and its message type (header field).
fn pass_data_level(pass: u16) u16 {
    if (pass == 0) return 3;    // M2M43: m_lvl3 partials
    if (pass == 1) return 2;    // M2M32: m_lvl2 partials
    if (pass <= 4) return 6 - pass;   // M2L: 4, 3, 2
    if (pass == 5) return 2;    // L2L23: l_lvl2
    if (pass == 6) return 3;    // L2L34: l_lvl3
    return 4;                   // P2P: leaf cells (bodies, see serp_emit_own_p2p)
}
fn pass_data_ptr(pass: u16) [*]f32 {
    const lv = pass_data_level(pass);
    if (pass >= PASS_L2L23) {
        const l = l_level_ptr(lv);
        return @ptrcast([*]f32, &l.*[0]);
    }
    const m = m_level_ptr(lv);
    return @ptrcast([*]f32, &m.*[0]);
}
fn pass_msg_type(pass: u16) u16 {
    if (pass < PASS_M2L4) return cons.MSG_M2M;
    if (pass <= PASS_M2L2) return cons.MSG_M2L;
    if (pass == PASS_P2P) return cons.MSG_P2P;
    return cons.MSG_L2L;
}

// Load pass `pass` from the table and reset all counters. Called BEFORE any
// message of the pass can arrive (end of the previous step). The transport is
// idle at that point: the previous pass has no send in flight and no drain
// armed (its drains reached n_rx).
fn serp_prepare(pass: u16) void {
    const b : u16 = pass * SERP_NF;
    serp_pass = pass;
    serp_dlevel = pass_data_level(pass);
    sp_in[0] = serp_tab[b + SF_IN0];   sp_out[0] = serp_tab[b + SF_OUT0];
    sp_in[1] = serp_tab[b + SF_IN1];   sp_out[1] = serp_tab[b + SF_OUT1];
    sp_nrx[0] = serp_tab[b + SF_NRX0]; sp_ntx[0] = serp_tab[b + SF_NTX0];
    sp_nrx[1] = serp_tab[b + SF_NRX1]; sp_ntx[1] = serp_tab[b + SF_NTX1];
    serp_nown = serp_tab[b + SF_NOWN];
    serp_hmax = serp_tab[b + SF_HMAX];
    for (@range(u16, 2)) |k| {
        sp_drain[k] = 0; sp_emit[k] = 0; sp_own[k] = 0; sp_busy[k] = 0;
    }
    for (@range(u16, 8)) |k| { serp_stats[k] = 0; }
    serp_done = 0;
    serp_started = 0;
    serp_active = 1;
    // Listen at once if this stream has no own message to send first: a
    // neighbour may start sending before this PE launches the pass.
    serp_maybe_arm(0);
    serp_maybe_arm(1);
}

fn serp_own_left(k: u16) u16 {
    if (sp_out[k] == DIR_NONE) return 0;
    return serp_nown - sp_own[k];
}

// P2P own message number sp_own[k]: cell blocks zbase = n*P2P_CELLS .. copied
// as raw words (counts are integers: no float move of them).
fn serp_emit_own_p2p(k: u16) void {
    const zbase : u16 = sp_own[k] * P2P_CELLS;
    var zcount : u16 = cells_per_side - zbase;
    if (zcount > P2P_CELLS) zcount = P2P_CELLS;
    const dir = sp_out[k];
    const buf = tx_buf_base(dir);
    buf[0] = @bitcast(f32, build_header(pe_x, pe_y, cons.MSG_P2P, 4, 1, zcount, zbase));
    const bw = @ptrcast([*]u32, &buf[1]);
    const w0 : u16 = zbase * CELL_BLOCK;
    for (@range(u16, zcount * CELL_BLOCK)) |i| { bw[i] = bodies_col[w0 + i]; }
    sp_own[k] += 1;
    sp_busy[k] = 1;
    send_raw(dir, buf);
}

// Launch own message number sp_own[k] (boxes zbase = n*K ..) on stream k.
fn serp_emit_own(k: u16) void {
    if (serp_pass == PASS_P2P) { serp_emit_own_p2p(k); return; }
    const nz : u16 = geom.grid_boxes(serp_dlevel);
    const zbase : u16 = sp_own[k] * cons.K_CUBES;
    var zcount : u16 = nz - zbase;
    if (zcount > cons.K_CUBES) zcount = cons.K_CUBES;
    const header = build_header(pe_x, pe_y, pass_msg_type(serp_pass), serp_dlevel,
                                1, zcount, zbase);
    const src = pass_data_ptr(serp_pass);
    const dir = sp_out[k];
    const buf = tx_buf_base(dir);
    fill_tx(buf, header, @ptrcast([*]f32, &src[zbase * cons.C_BUF_SIZE]),
            zcount * cons.C_BUF_SIZE);
    sp_own[k] += 1;
    sp_busy[k] = 1;
    send_raw(dir, buf);
}

fn serp_maybe_arm(k: u16) void {
    const din = sp_in[k];
    if (din == DIR_NONE) return;
    if (sp_drain[k] >= sp_nrx[k]) return;
    if (sp_busy[k] == 1) return;            // strict alternation (and the rx
                                            // buffer may be the one being sent)
    if (serp_own_left(k) > 0) return;       // own messages go first
    arm_drain(din);                         // no-op if already armed
}

// Plain add (M2M) or copy (L2L) of a message's boxes into a level buffer.
fn store_boxes(dst: [*]f32, zbase: u16, zcount: u16, payload: [*]f32, add: bool) void {
    for (@range(u16, zcount)) |ci| {
        const db : u16 = (zbase + ci) * cons.C_BUF_SIZE;
        const sb : u16 = ci * cons.C_BUF_SIZE;
        for (@range(u16, cons.C_BUF_SIZE)) |i| {
            if (add) { dst[db + i] += payload[sb + i]; } else { dst[db + i] = payload[sb + i]; }
        }
        serp_stats[4] += 1;
    }
}

// Consume one message of the current pass (header already read).
fn serp_consume(header: u32, payload: [*]f32) void {
    const sx = hdr_src_x(header);
    const sy = hdr_src_y(header);
    const zb = hdr_zbase(header);
    const zc = hdr_zcount(header);
    const p = serp_pass;
    if (p == PASS_M2M43) {
        // level-3 rep adds the partials of its own 2x2 block
        if (geom.pe_is_plane_node(pe_x, pe_y, 3) and (sx >> 1) == (pe_x >> 1)
            and (sy >> 1) == (pe_y >> 1)) {
            store_boxes(@ptrcast([*]f32, &m_lvl3[0]), zb, zc, payload, true);
        }
    } else if (p == PASS_M2M32) {
        // level-2 rep adds the partials of its own 4x4 block
        if (geom.pe_is_plane_node(pe_x, pe_y, 2) and (sx >> 2) == (pe_x >> 2)
            and (sy >> 2) == (pe_y >> 2)) {
            store_boxes(@ptrcast([*]f32, &m_lvl2[0]), zb, zc, payload, true);
        }
    } else if (p <= PASS_M2L2) {
        const lv = serp_dlevel;
        if (geom.pe_is_plane_node(pe_x, pe_y, lv)) {
            const sh : u16 = cons.TREE_H - lv;
            apply_m2l(lv, pe_x >> sh, pe_y >> sh, sx >> sh, sy >> sh, zb, zc, payload);
        }
    } else if (p == PASS_L2L23) {
        // a level-3 (non level-2) rep copies the l_lvl2 of ITS level-2 rep
        if (geom.pe_is_plane_node(pe_x, pe_y, 3) and !geom.pe_is_plane_node(pe_x, pe_y, 2)
            and sx == ((pe_x >> 2) << 2) and sy == ((pe_y >> 2) << 2)) {
            store_boxes(@ptrcast([*]f32, &l_lvl2[0]), zb, zc, payload, false);
        }
    } else if (p == PASS_L2L34) {
        // a non level-3 PE copies the l_lvl3 of ITS level-3 rep
        if (!geom.pe_is_plane_node(pe_x, pe_y, 3)
            and sx == ((pe_x >> 1) << 1) and sy == ((pe_y >> 1) << 1)) {
            store_boxes(@ptrcast([*]f32, &l_lvl3[0]), zb, zc, payload, false);
        }
    } else {
        // P2P: only the 8 plane-neighbour columns (the own column never
        // arrives: a PE does not receive its own messages)
        const adx : u16 = if (sx > pe_x) sx - pe_x else pe_x - sx;
        const ady : u16 = if (sy > pe_y) sy - pe_y else pe_y - sy;
        if (adx <= 1 and ady <= 1) {
            const pw = @ptrcast([*]u32, payload);
            for (@range(u16, zc)) |ci| {
                p2p_from_cell(zb + ci, @ptrcast([*]u32, &pw[ci * CELL_BLOCK]));
            }
        }
    }
}

// Launch the prepared pass on this PE: emit the first own message on each
// stream and, for M2L and P2P, do the column-local part (dx = dy = 0).
fn serp_begin() void {
    if (serp_active == 0) { serp_stats[7] += 1; return; }    // nothing prepared
    serp_started = 1;
    // A stream with own messages has not armed its drain (serp_maybe_arm), so
    // nothing can be in flight on it yet: start sending them now.
    if (serp_own_left(0) > 0) serp_emit_own(0);
    if (serp_own_left(1) > 0) serp_emit_own(1);
    if (serp_pass >= PASS_M2L4 and serp_pass <= PASS_M2L2) {
        const lv = serp_dlevel;
        if (geom.pe_is_plane_node(pe_x, pe_y, lv)) {
            const sh : u16 = cons.TREE_H - lv;
            const nz : u16 = geom.grid_boxes(lv);
            const m = pass_data_ptr(serp_pass);
            var zb : u16 = 0;
            while (zb < nz) {
                var zc : u16 = nz - zb;
                if (zc > cons.K_CUBES) zc = cons.K_CUBES;
                apply_m2l(lv, pe_x >> sh, pe_y >> sh, pe_x >> sh, pe_y >> sh,
                          zb, zc, @ptrcast([*]f32, &m[zb * cons.C_BUF_SIZE]));
                zb += zc;
            }
        }
    }
    if (serp_pass == PASS_P2P) p2p_column_local();
    serp_check_done();
}

// rx completion of rx code `dir`.
fn serp_on_rx(dir: u16) void {
    var k : u16 = 2;
    if (serp_active == 1) {
        if (dir == sp_in[0]) { k = 0; } else if (dir == sp_in[1]) { k = 1; }
    }
    if (k == 2) { serp_stats[5] += 1; return; }     // not a link of this pass
    const base = rx_buf_base(dir);
    const header : u32 = @bitcast(u32, base[0]);
    const hop : u16 = hdr_hop(header);
    sp_drain[k] += 1;
    serp_stats[k] += 1;
    if (sp_drain[k] > sp_nrx[k]) serp_stats[7] += 1;

    const fwd : bool = (sp_out[k] != DIR_NONE) and (hop < serp_hmax);
    if (fwd) {
        if (sp_busy[k] == 1) serp_stats[7] += 1;   // cannot happen (alternation)
        base[0] = @bitcast(f32, hdr_with_hop(header, hop + 1));
        sp_busy[k] = 1;
        send_raw(sp_out[k], base);       // straight from the rx buffer
    }
    serp_consume(header, @ptrcast([*]f32, &base[1]));
    if (!fwd) serp_maybe_arm(k);
    serp_check_done();
}

// tx completion of tx code `dir`.
fn serp_on_tx(dir: u16) void {
    var k : u16 = 2;
    if (dir == sp_out[0] and sp_busy[0] == 1) { k = 0; }
    else if (dir == sp_out[1] and sp_busy[1] == 1) { k = 1; }
    if (k == 2) { serp_stats[7] += 1; return; }     // unexpected completion
    sp_busy[k] = 0;
    sp_emit[k] += 1;
    serp_stats[2 + k] += 1;
    if (serp_started == 1 and serp_own_left(k) > 0) {
        serp_emit_own(k);
    } else {
        serp_maybe_arm(k);
    }
    serp_check_done();
}

fn serp_check_done() void {
    if (serp_done == 1 or serp_started == 0) return;
    if (sp_drain[0] != sp_nrx[0] or sp_emit[0] != sp_ntx[0] or sp_busy[0] == 1) return;
    if (sp_drain[1] != sp_nrx[1] or sp_emit[1] != sp_ntx[1] or sp_busy[1] == 1) return;
    serp_done = 1;
    serp_stats[6] = 1;
    for (@range(u16, 8)) |i| { serp_stats_all[serp_pass * 8 + i] = serp_stats[i]; }
    // Completion action of the pass (local, all its messages are in).
    const p = serp_pass;
    if (p == PASS_M2M43) {
        if (geom.pe_is_plane_node(pe_x, pe_y, 3)) m2m_z_local(3);   // m_lvl3 -> m_lvl2
    } else if (p == PASS_L2L23) {
        if (geom.pe_is_plane_node(pe_x, pe_y, 3)) l2l_z_local(2);   // l_lvl2 -> l_lvl3
    } else if (p == PASS_L2L34) {
        l2l_z_local(3);                                              // l_lvl3 -> l_lvl4
    }
    if (p + 1 < SERP_NPASS) {
        serp_prepare(p + 1);
    } else {
        serp_active = 0;
    }
    phase_signal_done(STEP_PASS0 + @as(u32, p));
}

// ===========================================================================
// P2M  (phase b core: zero communication)
// ===========================================================================
// For each leaf cell z in the column, build its 3D multipole from the bodies
// stored in that cell's block. Writes into m_lvl4[z].
//
// Body positions are absolute (domain coordinates); the multipole is expanded
// about the cell center (center_x, center_y, cz) where cz depends on z.

fn cell_center_z(z: u16) f32 {
    return (@as(f32, z) + 0.5) * cell_size;
}

fn compute_p2m_cell(z: u16) void {
    // Pointer to this cell's slot in the leaf multipole buffer.
    const m_base : u16 = z * cons.C_BUF_SIZE;

    // Clear this cell's multipole accumulator.
    for (@range(u16, cons.C_BUF_SIZE)) |i| {
        m_lvl4[m_base + i] = 0.0;
    }

    const blk : u16 = z * CELL_BLOCK;
    const count : u16 = @as(u16, bodies_col[blk]);
    const body0 : u16 = blk + 1;

    const cz : f32 = cell_center_z(z);

    for (@range(u16, count)) |b| {
        const ib : u16 = body0 + b * 4;
        const bx : f32 = @bitcast(f32, bodies_col[ib]);
        const by : f32 = @bitcast(f32, bodies_col[ib + 1]);
        const bz : f32 = @bitcast(f32, bodies_col[ib + 2]);
        const q  : f32 = @bitcast(f32, bodies_col[ib + 3]);

        const dx : f32 = bx - center_x;
        const dy : f32 = by - center_y;
        const dz : f32 = bz - cz;

        // Solid harmonics of this body's offset, into scratch.
        kernels.compute_solid_harmonics(dx, dy, dz, &contrib_buf);

        // Accumulate q * contrib into this cell's multipole.
        // (fmacs: SIMD-4 add path; the scalar fmul is inside compute_solid_harmonics.)
        const m_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{cons.C_BUF_SIZE} -> m_lvl4[i] });
        var m_dsd_cell = @set_dsd_base_addr(m_dsd, @ptrcast([*]f32, &m_lvl4[m_base]));
        const c_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{cons.C_BUF_SIZE} -> contrib_buf[i] });
        @fmacs(m_dsd_cell, m_dsd_cell, c_dsd, q);
    }
}

// Run P2M for every leaf cell in the column.
fn compute_p2m_column() void {
    for (@range(u16, cells_per_side)) |z| {
        compute_p2m_cell(z);
    }
}


// ===========================================================================
// M2M / L2L  (z-local math; the plane part is done by the serpentine passes)
// ===========================================================================
//
// A tree node (box) spans, on the plane, an s x s block of PEs (s =
// cells_per_box(parent_level)) and, along Z, is local to the column. Its 8
// children split into:
//   - 2 Z-LOCAL children: same (X,Y) column, Z indices (2*pz, 2*pz+1). Merged
//     in SRAM, ZERO hops (m2m_z_local / l2l_z_local below).
//   - 6 PLANE children: on other plane PEs. Each PE first translates its own
//     z children to the PARENT centre, so the plane combine is a plain add at
//     the representative (pass M2M43 / M2M32); downward, the representative's
//     local expansion is copied to the block (pass L2L23 / L2L34).
//
// child_id bits: bit0 = X, bit1 = Y, bit2 = Z (matches get_translation_vector).
// For the Z-local pair, the X,Y bits are this PE's offset within the parent
// block (relative to the parent representative); the Z bit is 0 / 1.
//
// Buffer pointer helpers: each level buffer is flat [n_z * C_BUF_SIZE]; node k
// starts at k * C_BUF_SIZE.

fn m_level_ptr(level: u16) *[cons.C_BUF_SIZE]f32 {
    // Returns a pointer to element 0 of the level's flat buffer. The caller
    // offsets by node index. We expose typed slices per level.
    // Only levels 2..4 are stored (see RESIDENT COLUMN STATE).
    if (level == 4) return @ptrcast(*[cons.C_BUF_SIZE]f32, &m_lvl4[0]);
    if (level == 3) return @ptrcast(*[cons.C_BUF_SIZE]f32, &m_lvl3[0]);
    return @ptrcast(*[cons.C_BUF_SIZE]f32, &m_lvl2[0]);
}

fn l_level_ptr(level: u16) *[cons.C_BUF_SIZE]f32 {
    if (level == 4) return @ptrcast(*[cons.C_BUF_SIZE]f32, &l_lvl4[0]);
    if (level == 3) return @ptrcast(*[cons.C_BUF_SIZE]f32, &l_lvl3[0]);
    return @ptrcast(*[cons.C_BUF_SIZE]f32, &l_lvl2[0]);
}

// This PE's (X,Y) offset bits within the block of a box at `parent_level`.
// The parent box representative is aligned to cells_per_box(parent_level).
// The child cells are aligned to cells_per_box(parent_level+1) = half. So the
// X,Y child_id bits are (pe_x / child_s) & 1, (pe_y / child_s) & 1, where
// child_s = cells_per_box(child_level).
fn plane_child_bits(child_level: u16, bit_x: *u16, bit_y: *u16) void {
    const child_s : u16 = geom.cells_per_box(child_level);
    bit_x.* = (pe_x / child_s) & 1;
    bit_y.* = (pe_y / child_s) & 1;
}

// Z-LOCAL M2M: aggregate the two Z children (2*pz, 2*pz+1) at child_level into
// parent node pz at parent_level, accumulating into the parent's M buffer.
// Pure, local, zero communication. Verifiable against a direct reference.
fn m2m_z_local(child_level: u16) void {
    const parent_level : u16 = child_level - 1;
    const nz_parent : u16 = geom.grid_boxes(parent_level);

    const child_m = m_level_ptr(child_level);
    const parent_m = m_level_ptr(parent_level);

    var bit_x : u16 = 0;
    var bit_y : u16 = 0;
    plane_child_bits(child_level, &bit_x, &bit_y);

    for (@range(u16, nz_parent)) |pz| {
        const cz0 : u16 = 2 * pz;      // Z child with z-bit 0
        const cz1 : u16 = 2 * pz + 1;  // Z child with z-bit 1

        // child_id for each Z child: X,Y bits fixed by this PE's block offset,
        // Z bit is 0 / 1.
        const cid0 : u16 = bit_x | (bit_y << 1) | (0 << 2);
        const cid1 : u16 = bit_x | (bit_y << 1) | (1 << 2);

        // Translation vector child -> parent, then its harmonics into v_buf.
        //
        // SIGN CONVENTION (verified numerically against a direct reference, rel
        // ~1e-15): the representative/parent is the LOW corner (min pe_x, pe_y,
        // low Z). get_translation_vector gives +half for child_id bit 0, but a
        // low-corner child's center lies BELOW the parent center, so the true
        // child->parent offset is NEGATED. get_translation_vector is called with
        // CHILD_level (its half_child_size = child box half-side = the offset
        // magnitude). This matches how the 3D L2L negated its vector.
        var t_vec = @zeros([3]f32);

        geom.get_translation_vector(@as(u32, cid0), child_level, &t_vec);
        kernels.compute_solid_harmonics(-t_vec[0], -t_vec[1], -t_vec[2], &v_buf);
        var child0 = @ptrcast(*[cons.C_BUF_SIZE]f32, &child_m.*[cz0 * cons.C_BUF_SIZE]);
        var par = @ptrcast(*[cons.C_BUF_SIZE]f32, &parent_m.*[pz * cons.C_BUF_SIZE]);
        kernels.translate(
            @ptrcast([*]f32, &v_buf[0]), @ptrcast([*]f32, &child0.*[0]), @ptrcast([*]f32, &par.*[0]),
            @ptrcast([*]u16, &m2m_offsets[0]), @ptrcast([*]u16, &m2m_child_indices[0]),
            @ptrcast([*]u16, &m2m_v_indices[0]), @ptrcast([*]u32, &m2m_signs[0]));

        geom.get_translation_vector(@as(u32, cid1), child_level, &t_vec);
        kernels.compute_solid_harmonics(-t_vec[0], -t_vec[1], -t_vec[2], &v_buf);
        var child1 = @ptrcast(*[cons.C_BUF_SIZE]f32, &child_m.*[cz1 * cons.C_BUF_SIZE]);
        kernels.translate(
            @ptrcast([*]f32, &v_buf[0]), @ptrcast([*]f32, &child1.*[0]), @ptrcast([*]f32, &par.*[0]),
            @ptrcast([*]u16, &m2m_offsets[0]), @ptrcast([*]u16, &m2m_child_indices[0]),
            @ptrcast([*]u16, &m2m_v_indices[0]), @ptrcast([*]u32, &m2m_signs[0]));
    }
}

// Z-LOCAL L2L: propagate a parent local expansion down to its two Z children.
// Mirror of m2m_z_local; the translation vector is parent -> child (negated).
fn l2l_z_local(parent_level: u16) void {
    const child_level : u16 = parent_level + 1;
    const nz_parent : u16 = geom.grid_boxes(parent_level);

    const parent_l = l_level_ptr(parent_level);
    const child_l = l_level_ptr(child_level);

    var bit_x : u16 = 0;
    var bit_y : u16 = 0;
    plane_child_bits(child_level, &bit_x, &bit_y);

    for (@range(u16, nz_parent)) |pz| {
        const cz0 : u16 = 2 * pz;
        const cz1 : u16 = 2 * pz + 1;

        const cid0 : u16 = bit_x | (bit_y << 1) | (0 << 2);
        const cid1 : u16 = bit_x | (bit_y << 1) | (1 << 2);

        // L2L uses the SAME sign/level convention as the 3D code: harmonics of
        // the NEGATED get_translation_vector(child_id, CHILD_level). This was
        // validated end-to-end in 3D. (A standalone unit test for L2L needs a
        // physical far-source field; it is deferred to the end-to-end force
        // check against direct N-body, which is the authoritative L2L test.)
        var t_vec = @zeros([3]f32);
        var par = @ptrcast(*[cons.C_BUF_SIZE]f32, &parent_l.*[pz * cons.C_BUF_SIZE]);

        geom.get_translation_vector(@as(u32, cid0), child_level, &t_vec);
        kernels.compute_solid_harmonics(-t_vec[0], -t_vec[1], -t_vec[2], &v_buf);
        var child0 = @ptrcast(*[cons.C_BUF_SIZE]f32, &child_l.*[cz0 * cons.C_BUF_SIZE]);
        kernels.translate(
            @ptrcast([*]f32, &v_buf[0]), @ptrcast([*]f32, &par.*[0]), @ptrcast([*]f32, &child0.*[0]),
            @ptrcast([*]u16, &l2l_offsets[0]), @ptrcast([*]u16, &l2l_source_indices[0]),
            @ptrcast([*]u16, &l2l_v_indices[0]), @ptrcast([*]u32, &l2l_signs[0]));

        geom.get_translation_vector(@as(u32, cid1), child_level, &t_vec);
        kernels.compute_solid_harmonics(-t_vec[0], -t_vec[1], -t_vec[2], &v_buf);
        var child1 = @ptrcast(*[cons.C_BUF_SIZE]f32, &child_l.*[cz1 * cons.C_BUF_SIZE]);
        kernels.translate(
            @ptrcast([*]f32, &v_buf[0]), @ptrcast([*]f32, &par.*[0]), @ptrcast([*]f32, &child1.*[0]),
            @ptrcast([*]u16, &l2l_offsets[0]), @ptrcast([*]u16, &l2l_source_indices[0]),
            @ptrcast([*]u16, &l2l_v_indices[0]), @ptrcast([*]u32, &l2l_signs[0]));
    }
}



// ===========================================================================
// P2P  (near field: direct sum over the cells at |dx|, |dy|, |dz| <= 1)
// ===========================================================================
// The column-local part (own and z-adjacent cells, 0 hops) runs at the begin
// of pass P2P; the cells of the 8 plane-neighbour columns arrive as messages.
const math_mod = @import_module("<math>");
fn math_sqrt(x: f32) f32 { return math_mod.sqrt(x); }

// Force and potential on every body of target cell tz of this column from the
// bodies of ONE source cell block `src` (layout of bodies_col: count, then
// x, y, z, q per body). Pairs with r2 <= 1e-10 (a body with itself) are
// skipped. Accumulates into forces_col.
fn p2p_accumulate(tz: u16, src: [*]u32) void {
    const scount : u16 = @as(u16, src[0]);
    const tblk : u16 = tz * CELL_BLOCK;
    const tcount : u16 = @as(u16, bodies_col[tblk]);
    const fcell_base : u16 = tz * (max_bodies_pe * 4);
    for (@range(u16, tcount)) |ti| {
        const ib : u16 = tblk + 1 + ti * 4;
        const tx : f32 = @bitcast(f32, bodies_col[ib]);
        const ty : f32 = @bitcast(f32, bodies_col[ib + 1]);
        const tzc : f32 = @bitcast(f32, bodies_col[ib + 2]);
        var fx : f32 = 0.0; var fy : f32 = 0.0; var fz : f32 = 0.0; var pot : f32 = 0.0;
        for (@range(u16, scount)) |ri| {
            const rb : u16 = 1 + ri * 4;
            const ddx = @bitcast(f32, src[rb]) - tx;
            const ddy = @bitcast(f32, src[rb + 1]) - ty;
            const ddz = @bitcast(f32, src[rb + 2]) - tzc;
            const rq : f32 = @bitcast(f32, src[rb + 3]);
            const r2 = ddx*ddx + ddy*ddy + ddz*ddz;
            if (r2 > 1e-10) {
                const rinv = 1.0 / math_sqrt(r2);
                const ff = rq * rinv * rinv * rinv;
                fx += ff * ddx; fy += ff * ddy; fz += ff * ddz;
                pot += rq * rinv;
            }
        }
        const fo : u16 = fcell_base + ti * 4;
        forces_col[fo]     += fx;
        forces_col[fo + 1] += fy;
        forces_col[fo + 2] += fz;
        forces_col[fo + 3] += pot;
    }
    serp_stats[4] += 1;     // (target cell, source cell) pairs (diagnostic)
}

// Source cell sz (of this or a neighbour column) acts on target cells
// sz-1, sz, sz+1 of this column.
fn p2p_from_cell(sz: u16, src: [*]u32) void {
    var tz : u16 = if (sz > 0) sz - 1 else 0;
    while (tz <= sz + 1 and tz < cells_per_side) {
        p2p_accumulate(tz, src);
        tz += 1;
    }
}

// Column-local part: every cell of the column on its own and z-adjacent cells.
fn p2p_column_local() void {
    var sz : u16 = 0;
    while (sz < cells_per_side) {
        p2p_from_cell(sz, @ptrcast([*]u32, &bodies_col[sz * CELL_BLOCK]));
        sz += 1;
    }
}


// ===========================================================================
// ENTRY POINTS  (host-mediated barriers)
// ===========================================================================
//
// PROTOCOL (one rule for every exported fn):
//   - it calls sys_mod.unblock_cmd_stream() EXACTLY ONCE, as its last
//     statement, whether or not its work is complete;
//   - when this PE's step is TRULY complete (possibly later, from a task) it
//     writes the step id into fmm_done[0]; the host polls fmm_done until every
//     PE shows the step id, which is the global barrier;
//   - the state of the next step is prepared before any of its messages can
//     arrive (PEs do not enter a launch simultaneously). fmm_done is never
//     cleared, so an early completion is not lost either.
// Host sequence and step ids:
//   run_p2m (1) -> run_pass x8 (2..9: M2M43 M2M32 M2L4 M2L3 M2L2 L2L23 L2L34
//   P2P) -> run_l2p (10)
const STEP_P2M : u32 = 1;
const STEP_PASS0 : u32 = 2;
const STEP_L2P : u32 = 10;

fn phase_signal_done(step: u32) void {
    fmm_done[0] = step;
}

fn init_position() void {
    pe_x = pe_x_param;
    pe_y = pe_y_param;
    center_x = (@as(f32, pe_x) + 0.5) * cell_size;
    center_y = (@as(f32, pe_y) + 0.5) * cell_size;
}

fn clear_level_buffers() void {
    for (@range(u16, NZ3 * cons.C_BUF_SIZE)) |i| { m_lvl3[i] = 0.0; }
    for (@range(u16, NZ2 * cons.C_BUF_SIZE)) |i| { m_lvl2[i] = 0.0; }
    for (@range(u16, NZ4 * cons.C_BUF_SIZE)) |i| { l_lvl4[i] = 0.0; }
    for (@range(u16, NZ3 * cons.C_BUF_SIZE)) |i| { l_lvl3[i] = 0.0; }
    for (@range(u16, NZ2 * cons.C_BUF_SIZE)) |i| { l_lvl2[i] = 0.0; }
}

// P2M, then the column-local start of the upward pass: every PE translates its
// leaf multipoles into its m_lvl3 partial about the level-3 parent centre (the
// partials are then summed at the level-3 rep by pass M2M43).
export fn run_p2m() void {
    init_position();
    for (@range(u16, cells_per_side * max_bodies_pe * 4)) |i| {
        forces_col[i] = 0.0;
    }
    compute_p2m_column();
    clear_level_buffers();
    m2m_z_local(4);
    serp_prepare(0);
    phase_signal_done(STEP_P2M);
    sys_mod.unblock_cmd_stream();
}

// Launch the prepared serpentine pass (the host calls this once per pass).
export fn run_pass() void {
    serp_begin();
    sys_mod.unblock_cmd_stream();
}

export fn run_l2p() void {
    // Evaluate the leaf local expansion at each body; accumulate far-field force
    // (forces_col already holds the near field of pass P2P).
    var z : u16 = 0;
    while (z < cells_per_side) {
        const blk : u16 = z * CELL_BLOCK;
        const count : u16 = @as(u16, bodies_col[blk]);
        const body0 : u16 = blk + 1;
        const cz : f32 = cell_center_z(z);
        const fcell_base : u16 = z * (max_bodies_pe * 4);
        var lexp = @ptrcast(*[cons.C_BUF_SIZE]f32, &l_lvl4[z * cons.C_BUF_SIZE]);
        for (@range(u16, count)) |b| {
            const ib : u16 = body0 + b * 4;
            const bx : f32 = @bitcast(f32, bodies_col[ib]);
            const by : f32 = @bitcast(f32, bodies_col[ib + 1]);
            const bz : f32 = @bitcast(f32, bodies_col[ib + 2]);
            const ddx = bx - center_x;
            const ddy = by - center_y;
            const ddz = bz - cz;
            var pot : f32 = 0.0; var fx : f32 = 0.0; var fy : f32 = 0.0; var fz : f32 = 0.0;
            kernels.evaluate_l2p(ddx, ddy, ddz, lexp, &pot, &fx, &fy, &fz);
            const fo : u16 = fcell_base + b * 4;
            forces_col[fo]     += fx;
            forces_col[fo + 1] += fy;
            forces_col[fo + 2] += fz;
            forces_col[fo + 3] += pot;
        }
        z += 1;
    }
    phase_signal_done(STEP_L2P);
    sys_mod.unblock_cmd_stream();
}


// ===========================================================================
// HOST POINTERS
// ===========================================================================
var ptr_bodies_col : [*]u32 = &bodies_col;
var ptr_forces_col : [*]f32 = &forces_col;
var ptr_fmm_done : [*]u32 = &fmm_done;

var ptr_m2m_offsets : [*]u16 = &m2m_offsets;
var ptr_m2m_child_indices : [*]u16 = &m2m_child_indices;
var ptr_m2m_v_indices : [*]u16 = &m2m_v_indices;
var ptr_m2m_signs : [*]u32 = &m2m_signs;

var ptr_m2l_offsets : [*]u16 = &m2l_offsets;
var ptr_m2l_source_indices : [*]u16 = &m2l_source_indices;
var ptr_m2l_v_indices : [*]u16 = &m2l_v_indices;
var ptr_m2l_signs : [*]u32 = &m2l_signs;

var ptr_l2l_offsets : [*]u16 = &l2l_offsets;
var ptr_l2l_source_indices : [*]u16 = &l2l_source_indices;
var ptr_l2l_v_indices : [*]u16 = &l2l_v_indices;
var ptr_l2l_signs : [*]u32 = &l2l_signs;

var ptr_serp_tab : [*]u16 = &serp_tab;
var ptr_serp_stats : [*]u32 = &serp_stats;
var ptr_serp_stats_all : [*]u32 = &serp_stats_all;
var ptr_l_lvl4 : [*]f32 = &l_lvl4;


// ===========================================================================
// COMPTIME
// ===========================================================================
comptime {
    @comptime_assert(P2P_CELLS >= 1);   // max_bodies_pe too large for one cell

    // Fabric routes: software forwarding => only RAMP<->neighbour routes. Each
    // color routes either RAMP->dir (this PE sends on it) or dir->RAMP (this PE
    // receives on it). (The parity choice is in the c_*_out / c_*_in consts.)
    @set_local_color_config(c_e_out, .{ .routes = .{ .rx = .{ RAMP },  .tx = .{ EAST } } });
    @set_local_color_config(c_w_out, .{ .routes = .{ .rx = .{ RAMP },  .tx = .{ WEST } } });
    @set_local_color_config(c_e_in,  .{ .routes = .{ .rx = .{ WEST },  .tx = .{ RAMP } } });
    @set_local_color_config(c_w_in,  .{ .routes = .{ .rx = .{ EAST },  .tx = .{ RAMP } } });
    @set_local_color_config(c_n_out, .{ .routes = .{ .rx = .{ RAMP },  .tx = .{ NORTH } } });
    @set_local_color_config(c_s_out, .{ .routes = .{ .rx = .{ RAMP },  .tx = .{ SOUTH } } });
    @set_local_color_config(c_n_in,  .{ .routes = .{ .rx = .{ SOUTH }, .tx = .{ RAMP } } });
    @set_local_color_config(c_s_in,  .{ .routes = .{ .rx = .{ NORTH }, .tx = .{ RAMP } } });

    if (@is_arch("wse3")) {
        @initialize_queue(cons.e_iq, .{ .color = c_e_in });
        @initialize_queue(cons.w_iq, .{ .color = c_w_in });
        @initialize_queue(cons.n_iq, .{ .color = c_n_in });
        @initialize_queue(cons.s_iq, .{ .color = c_s_in });
        @initialize_queue(cons.e_oq, .{ .color = c_e_out });
        @initialize_queue(cons.w_oq, .{ .color = c_w_out });
        @initialize_queue(cons.n_oq, .{ .color = c_n_out });
        @initialize_queue(cons.s_oq, .{ .color = c_s_out });
    }

    @bind_local_task(rx_complete_e, cons.rx_complete_e_id);
    @bind_local_task(rx_complete_w, cons.rx_complete_w_id);
    @bind_local_task(rx_complete_n, cons.rx_complete_n_id);
    @bind_local_task(rx_complete_s, cons.rx_complete_s_id);
    @bind_local_task(tx_complete_e, cons.tx_complete_e_id);
    @bind_local_task(tx_complete_w, cons.tx_complete_w_id);
    @bind_local_task(tx_complete_n, cons.tx_complete_n_id);
    @bind_local_task(tx_complete_s, cons.tx_complete_s_id);

    @export_symbol(ptr_bodies_col, "ptr_bodies_col");
    @export_symbol(ptr_forces_col, "ptr_forces_col");
    @export_symbol(ptr_fmm_done, "ptr_fmm_done");
    @export_symbol(run_p2m, "run_p2m");
    @export_symbol(run_pass, "run_pass");
    @export_symbol(run_l2p, "run_l2p");

    @export_symbol(ptr_m2m_offsets, "ptr_m2m_offsets");
    @export_symbol(ptr_m2m_child_indices, "ptr_m2m_child_indices");
    @export_symbol(ptr_m2m_v_indices, "ptr_m2m_v_indices");
    @export_symbol(ptr_m2m_signs, "ptr_m2m_signs");

    @export_symbol(ptr_m2l_offsets, "ptr_m2l_offsets");
    @export_symbol(ptr_m2l_source_indices, "ptr_m2l_source_indices");
    @export_symbol(ptr_m2l_v_indices, "ptr_m2l_v_indices");
    @export_symbol(ptr_m2l_signs, "ptr_m2l_signs");

    @export_symbol(ptr_l2l_offsets, "ptr_l2l_offsets");
    @export_symbol(ptr_l2l_source_indices, "ptr_l2l_source_indices");
    @export_symbol(ptr_l2l_v_indices, "ptr_l2l_v_indices");
    @export_symbol(ptr_l2l_signs, "ptr_l2l_signs");

    @export_symbol(ptr_serp_tab, "ptr_serp_tab");
    @export_symbol(ptr_serp_stats, "ptr_serp_stats");
    @export_symbol(ptr_serp_stats_all, "ptr_serp_stats_all");
    @export_symbol(ptr_l_lvl4, "ptr_l_lvl4");
}
